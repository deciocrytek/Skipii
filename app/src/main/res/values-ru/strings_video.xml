<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Video player overlay (portrait "on the video" controls and fullscreen), quality/speed pickers, errors. -->

    <!-- Small note under the loading spinner while YouTube runs a bot check on this connection. -->
    <string name="video_bot_check_waiting">YouTube проверяет это подключение. Повторная попытка…</string>

    <!-- Accessibility labels of the round buttons on the video. -->
    <string name="video_audio_only">Только аудио</string>
    <!-- Accessibility label of the filled audio-only button shown while audio only is on (tap turns it off). -->
    <string name="video_audio_only_on">Режим «Только аудио» включён</string>
    <string name="video_playback_speed">Скорость воспроизведения</string>
    <string name="video_captions">Субтитры</string>
    <string name="video_quality">Качество</string>
    <string name="video_pip">Картинка в картинке</string>
    <string name="video_next">Далее</string>
    <string name="video_fullscreen">Во весь экран</string>
    <string name="video_exit_fullscreen">Выйти из полноэкранного режима</string>
    <string name="video_play">Воспроизвести</string>
    <string name="video_pause">Пауза</string>
    <!-- Accessibility label of the check mark on the chosen row of a picker. -->
    <string name="video_selected">Выбрано</string>

    <!-- Message shown when picture-in-picture can't start because the user turned it off in Android's settings. -->
    <string name="video_pip_off">Режим «Картинка в картинке» отключён для Skipii в настройках.</string>

    <!-- Quality: automatic. Also the start of the quality pill on the video ("Auto · 720p"): small pill, keep short. -->
    <string name="video_quality_auto">Авто</string>
    <!-- Subtitle of the Auto row in the quality sheet. -->
    <string name="video_quality_auto_best">Лучшее до 1080p</string>
    <!-- Appended to the Auto row's subtitle after " · "; %1$s = a resolution like "720p". -->
    <string name="video_quality_auto_playing">сейчас %1$s</string>
    <!-- Under the quality sheet's title; %1$s = the format being played, like "1080p60 H.264". -->
    <string name="video_quality_playing">Сейчас: %1$s</string>
    <!-- Quality tag for the lowest resolutions (240p and below). -->
    <string name="video_quality_data_saver">Экономия трафика</string>
    <!-- Quality tag for 1080p. -->
    <string name="video_quality_full_hd">Full HD</string>

    <!-- Title of the speed sheet. -->
    <string name="video_speed">Скорость</string>

    <!-- Headers of the small fullscreen picker cards, shown in CAPITALS (write them in capitals where the script has them). -->
    <string name="video_drop_captions">СУБТИТРЫ</string>
    <string name="video_drop_quality">КАЧЕСТВО</string>
    <string name="video_drop_speed">СКОРОСТЬ</string>

    <!-- Captions card: row that turns captions off. -->
    <string name="video_captions_off">Выкл.</string>
    <!-- Captions card: small grey tags after a language name. -->
    <string name="video_captions_tag_auto">авто</string>
    <string name="video_captions_tag_downloading">скачивание</string>
    <string name="video_captions_tag_translated">перевод</string>
    <string name="video_captions_tag_download">скачать</string>

    <!-- Speed card: tag after 1× -->
    <string name="video_speed_normal">Обычная</string>
    <!-- Speed card: tag after a speed set on the ruler that isn't one of the presets. -->
    <string name="video_speed_custom">Своя</string>
    <!-- Speed card: row that keeps the speed for every video (toggle). -->
    <string name="video_speed_every_video">Для всех видео</string>

    <!-- SponsorBlock pill, small: %1$s = the segment kind ("sponsor", "intro", …). Keep short. -->
    <string name="video_skip_segment">Пропустить: %1$s</string>
    <!-- After an automatic skip: %1$s = length ("1:12"), %2$s = the segment kind ("sponsor"). -->
    <string name="video_skipped_segment">Пропущено %1$s · %2$s</string>
    <!-- Button after the "Skipped …" note. -->
    <string name="video_undo">Отменить</string>

    <!-- Button on the playback error panel. -->
    <string name="video_try_again">Повторить попытку</string>
    <string name="video_open_in_youtube">Открыть в YouTube</string>
</resources>
