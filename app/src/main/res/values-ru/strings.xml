<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s тыс.</string>
    <string name="count_millions">%1$s млн</string>
    <string name="count_billions">%1$s млрд</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1.2M"); the quantity is the exact count. -->
    <plurals name="views_count">
        <item quantity="one">%1$s просмотр</item>
        <item quantity="few">%1$s просмотра</item>
        <item quantity="many">%1$s просмотров</item>
        <item quantity="other">%1$s просмотра</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="one">%1$s подписчик</item>
        <item quantity="few">%1$s подписчика</item>
        <item quantity="many">%1$s подписчиков</item>
        <item quantity="other">%1$s подписчика</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("3 days ago"). -->
    <string name="age_just_now">только что</string>
    <string name="age_streamed">Трансляция закончилась %1$s</string>
    <string name="age_premiered">Премьера состоялась %1$s</string>

    <!-- The account sheet's Language card (LanguageSettings). -->
    <string name="language_title">Язык</string>
    <string name="language_phone">Язык телефона</string>
    <!-- %1$s is the language's own name ("Español"). -->
    <string name="language_phone_named">Язык телефона (%1$s)</string>
    <string name="language_line">Только надписи самого приложения. Видео, названия и комментарии остаются такими, какими их написали авторы.</string>
</resources>
