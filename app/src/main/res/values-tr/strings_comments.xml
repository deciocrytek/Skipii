    <string name="captions_more_languages">Diğer diller</string>
    <string name="captions_none">Bu videoda altyazı yok.</string>
    <!-- Accessibility label of the check on the chosen row. -->
    <string name="captions_selected">Seçili</string>
    <!-- Accessibility label of the transcript panel's close (X) button. -->
    <string name="captions_close_transcript">Transkripti kapat</string>
    <string name="captions_no_transcript">Bu videoda altyazı olmadığı için transkript de yok.</string>
    <string name="captions_no_lines">Henüz satır yok.</string>
    <!-- Transcript search found nothing. %1$s = what was typed. -->
    <string name="captions_nothing_matches">\"%1$s\" ile eşleşen bir şey yok.</string>
    <!-- Button that scrolls the transcript back to the line being said. -->
    <string name="captions_back_to_now">Şu ana dön</string>
    <!-- Placeholder of the transcript's search field. -->
    <string name="captions_search_transcript">Transkriptte ara</string>
    <!-- Accessibility label of the X that clears the search. -->
    <string name="captions_clear_search">Aramayı temizle</string>

    <!-- Settings card (account sheet). -->
    <string name="captions_settings_subtitle">Oynatıcıda bir dil seçin veya altyazıları kapatın</string>
    <!-- A sample caption in the settings preview, shown as two lines over a picture: this is the first line… -->
    <string name="captions_sample_line_1">Altyazılar videoda</string>
    <!-- …and this the second. Split the sentence about evenly. -->
    <string name="captions_sample_line_2">böyle görünecek.</string>
