    <string name="captions_size">Boyut</string>
    <string name="captions_size_small">Küçük</string>
    <string name="captions_size_medium">Orta</string>
    <string name="captions_size_large">Büyük</string>
    <string name="captions_size_huge">Çok büyük</string>
    <!-- Setting label over the downloaded translation languages (each with an X to delete it). -->
    <string name="captions_kept_languages">Bu telefondaki çeviri dilleri</string>
    <!-- Accessibility label of a downloaded language's X. %1$s = the language. -->
    <string name="captions_remove_language">Kaldır: %1$s</string>
