<resources>
    <!-- ── Comments ─────────────────────────────────────────────────────────── -->

    <!-- Title of the comments card under the video and of the comments panel. -->
    <string name="comments_title">Yorumlar</string>
    <string name="comments_turned_off">Bu videoda yorumlar kapalı.</string>
