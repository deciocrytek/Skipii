<resources>
    <!-- Bottom tab bar labels (MainActivity Tab, drawn by NavBar). Tight: the selected tab shows its label
         beside the icon in a shared pill; keep as short as possible (~12 characters). -->
    <string name="app_tab_home">Home</string>
    <string name="app_tab_subscriptions">Subscriptions</string>
    <!-- YouTube's name for its short vertical videos; most languages keep "Shorts". -->
    <string name="app_tab_shorts">Shorts</string>
    <string name="app_tab_search">Search</string>
    <string name="app_tab_library">Library</string>

    <!-- Self-update: the Update pill in Home's header, beside the profile picture. Short (~10 characters). -->
    <string name="app_update_pill">Update</string>
    <!-- Update pill while installing. Short (~10 characters). -->
    <string name="app_update_pill_installing">Installing</string>
    <!-- Update pill after a failed download/install. Short (~10 characters). -->
    <string name="app_update_pill_retry">Retry</string>
    <!-- Download progress, %1$s is a whole number 0-100 ("42%"). -->
    <string name="app_update_percent">%1$s%%</string>
    <!-- Title of the "What's new" sheet listing the release notes of a new version. -->
    <string name="app_update_whats_new">What\'s new</string>
    <!-- Download size of the new version, %1$s is a number with one decimal ("16.8"). -->
    <string name="app_update_size_mb">%1$s MB</string>
    <string name="app_update_no_notes">No notes were published with this version.</string>
    <!-- The What's new sheet's full-width button. -->
    <string name="app_update_button">Update</string>
    <!-- The sheet's button while downloading, %1$s is a whole number 0-100. -->
    <string name="app_update_downloading">Downloading %1$s%%</string>
    <string name="app_update_installing">Installing…</string>
    <string name="app_update_try_again">Try again</string>
    <!-- Notification channel name (Android Settings › Notifications). -->
    <string name="app_update_channel">App updates</string>
    <!-- Notification after the app updated itself, %1$s is the version ("0.5.79"). -->
    <string name="app_updated_title">Skipii updated to %1$s</string>
    <string name="app_updated_text">Tap to open</string>

    <!-- The Subscribe button (player and channel page). Short: shares a row with the bell key. -->
    <string name="app_subscribe">Subscribe</string>
    <string name="app_subscribed">Subscribed</string>
    <!-- Accessibility labels of the bell key next to Subscribed. -->
    <string name="app_bell_on_description">Bell on: every new video. Tap to turn off</string>
    <string name="app_bell_off_description">Bell: get a notification for every new video</string>
    <!-- Messages after turning a channel's bell on/off. %1$s is the channel's name. -->
    <string name="app_bell_on_message">Every new video from %1$s</string>
    <string name="app_bell_off_message">Notifications off for %1$s</string>
    <!-- Same, when the channel's name isn't known. -->
    <string name="app_bell_on_message_unnamed">Every new video from this channel</string>
    <string name="app_bell_off_message_unnamed">Notifications off for this channel</string>
    <string name="app_bell_failed">Couldn\'t change the bell.</string>
    <!-- Notifications were refused when asked (Android 13+). -->
    <string name="app_bell_allow_notifications">Allow Skipii\'s notifications to use the bell.</string>
    <!-- Notifications are off in Android's settings; the settings page opens next. -->
    <string name="app_bell_turn_on_notifications">Turn on Skipii\'s notifications to use the bell.</string>

    <!-- Notification channel for new videos from channels with the bell on (Android Settings › Notifications). -->
    <string name="app_new_videos_channel">New videos</string>
    <string name="app_new_videos_channel_description">Every new video from channels with the bell on</string>
    <!-- A new-video notification's title when the channel's name isn't known. -->
    <string name="app_new_video_unnamed">New video</string>

    <!-- The signed-in account's name when Google's page didn't give one. -->
    <string name="app_account_fallback_name">YouTube account</string>
    <!-- Errors shown on the signed-in feeds. %1$s is an HTTP status code ("403"). -->
    <string name="app_error_session_rejected">YouTube rejected the session (%1$s). Try signing in again.</string>
    <string name="app_error_youtube_returned">YouTube returned %1$s</string>
    <!-- The live activity's notification channel, and its skip buttons. %1$s = seconds ("10"). -->
    <string name="app_live_channel">Playing in the background</string>
    <string name="app_live_channel_description">Playback controls while Skipii is off screen</string>
    <string name="app_live_back">−%1$s s</string>
    <string name="app_live_forward">+%1$s s</string>
</resources>
