    <string name="ui_home_signed_out_title">I tuoi consigli, senza pubblicità</string>
    <string name="ui_home_signed_out_body">Accedi con Google per vedere la tua Home di YouTube, oppure cerca e basta.</string>
    <!-- Text link under "Sign in with Google" on Home when signed out. -->
    <string name="ui_search_instead">Cerca e basta</string>
    <!-- Page title (large header). -->
    <string name="ui_subscriptions_title">Iscrizioni</string>
