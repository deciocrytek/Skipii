    <string name="ui_shorts">Shorts</string>
    <string name="ui_shorts_on_line">Mostra la scheda Shorts</string>
    <string name="ui_shorts_off_line">La scheda Shorts è nascosta e nessuno Short viene caricato</string>
    <string name="ui_appearance">Aspetto</string>
