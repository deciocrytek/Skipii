    <string name="ui_finishing_sign_in">Completamento dell\'accesso…</string>
    <!-- Accessibility label of the account button when signed out. -->
    <string name="ui_sign_in">Accedi</string>
    <string name="ui_account_pitch_title">Il tuo YouTube, senza pubblicità</string>
    <string name="ui_account_pitch_body">Accedi per avere i tuoi consigli, le iscrizioni, la cronologia e le playlist. Mi piace, iscrizioni, Guarda più tardi e cronologia delle visualizzazioni vengono sincronizzati con il tuo account.</string>
    <string name="ui_sign_out">Esci</string>

