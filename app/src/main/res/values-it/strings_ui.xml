    <string name="ui_playlist_name">Nome della playlist</string>
    <!-- Small button (~10 characters) that creates the new playlist. -->
    <string name="ui_create">Crea</string>

    <!-- ── Queue ──────────────────────────────────────────────────────────── -->
    <!-- Card under the player: "Queue · 3" = 3 videos queued (%1$s). Keep short. -->
    <plurals name="ui_queue_count">
        <item quantity="one">Coda · %1$s</item>
        <item quantity="many">Coda · %1$s</item>
        <item quantity="other">Coda · %1$s</item>
    </plurals>
    <!-- Small button (~8 characters) that empties the queue. -->
    <string name="ui_clear">Svuota</string>
    <!-- Title of the queue sheet. -->
    <string name="ui_queue">Coda</string>
    <!-- Accessibility label of the X on a queued video. -->
    <string name="ui_remove_from_queue">Rimuovi dalla coda</string>
    <string name="ui_queue_empty">Coda vuota. Tieni premuto un video per aggiungerlo.</string>

    <!-- ── Account sheet: settings ────────────────────────────────────────── -->
    <!-- Line under the SponsorBlock switch. -->
    <string name="ui_sponsorblock_line">Salta sponsor e altri segmenti</string>
    <!-- Required credit under the SponsorBlock settings; keep "sponsor.ajay.app" and "CC BY-NC-SA 4.0" as they are. -->
    <string name="ui_sponsorblock_credit">Segmenti da SponsorBlock (sponsor.ajay.app), un progetto della community. Dati con licenza CC BY-NC-SA 4.0.</string>
    <string name="ui_player_controls">Controlli del player</string>
    <!-- Line under "Player controls" when the controls live in the bottom pill. -->
    <string name="ui_player_controls_in_bar_line">Nella barra di riproduzione in fondo al player</string>
    <!-- Line under "Player controls" when the controls are drawn over the video. -->
    <string name="ui_player_controls_on_video_line">Sul video; trascina il cursore sul bordo inferiore per scorrere</string>
    <!-- Chips (~14 characters): where the player's controls live. -->
    <string name="ui_player_controls_pill">Barra in basso</string>
    <string name="ui_player_controls_on_video">Sul video</string>
