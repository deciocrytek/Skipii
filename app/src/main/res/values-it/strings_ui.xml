<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── Shared ─────────────────────────────────────────────────────────── -->
    <!-- Button after an error (a feed, a search, a channel, the playlists list). -->
    <string name="ui_try_again">Riprova</string>
    <!-- Accessibility label of a round back-arrow button at the top of a page. -->
    <string name="ui_back">Indietro</string>
    <!-- Button that closes a page or message. -->
    <string name="ui_close">Chiudi</string>
    <!-- Button, ~20 characters: opens Google's sign-in page. -->
    <string name="ui_sign_in_with_google">Accedi con Google</string>
    <!-- Name of the account's built-in playlist of videos saved for later (YouTube's "Watch later"). -->
    <string name="ui_watch_later">Guarda più tardi</string>
    <!-- Name of the account's built-in playlist of liked videos. -->
    <string name="ui_liked_videos">Video piaciuti</string>

    <!-- ── Long-press options on a video ──────────────────────────────────── -->
    <string name="ui_play_next">Riproduci dopo</string>
    <string name="ui_add_to_queue">Aggiungi alla coda</string>
    <string name="ui_save_to_watch_later">Salva in Guarda più tardi</string>
    <!-- Option and the title of the sheet listing the account's playlists. -->
    <string name="ui_save_to_playlist">Salva in playlist</string>
    <string name="ui_share">Condividi</string>

    <!-- ── Save to playlist sheet ─────────────────────────────────────────── -->
    <!-- Accessibility label of the check on a playlist that holds the video. -->
    <string name="ui_saved">Salvato</string>
    <!-- Playlist privacy, a small chip (~10 characters) and the line under a playlist's name. -->
    <string name="ui_privacy_private">Privata</string>
    <string name="ui_privacy_unlisted">Non in elenco</string>
    <string name="ui_privacy_public">Pubblica</string>
    <string name="ui_new_playlist">Nuova playlist</string>
