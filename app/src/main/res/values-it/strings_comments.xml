<resources>
    <!-- ── Comments ─────────────────────────────────────────────────────────── -->

    <!-- Title of the comments card under the video and of the comments panel. -->
    <string name="comments_title">Commenti</string>
    <string name="comments_turned_off">I commenti sono disattivati per questo video.</string>
    <!-- Comments card, signed in, when the video has no comments yet. -->
    <string name="comments_none_add_first">Ancora nessun commento. Aggiungi il primo.</string>
    <string name="comments_none">Ancora nessun commento.</string>
    <!-- Accessibility label of the panel's close (X) button. -->
    <string name="comments_close">Chiudi i commenti</string>
    <!-- Shown at the bottom of the comments panel instead of the comment box when signed out. -->
    <string name="comments_sign_in_to_comment">Accedi per commentare.</string>
    <!-- Above the comment box while replying. %1$s = the name of the person replied to. -->
    <string name="comments_replying_to">Risposta a %1$s</string>
    <!-- Accessibility label of the X that stops replying. -->
    <string name="comments_cancel_reply">Annulla risposta</string>
    <!-- Placeholder in the comment box. -->
    <string name="comments_add_reply">Aggiungi una risposta…</string>
    <string name="comments_add_comment">Aggiungi un commento…</string>
    <!-- Accessibility label of the send button (posts the comment). -->
    <string name="comments_post">Pubblica</string>
    <!-- Accessibility label of the pin icon on a pinned comment. -->
    <string name="comments_pinned">Fissato</string>
    <!-- Accessibility labels of a comment's thumbs-up button. -->
    <string name="comments_like">Mi piace</string>
    <string name="comments_unlike">Togli Mi piace</string>
    <!-- Accessibility label of the heart the video's creator gave a comment. -->
    <string name="comments_hearted">Cuore del creator</string>
    <!-- Small text button under a comment, keep short. -->
    <string name="comments_reply">Rispondi</string>
    <!-- Text button that folds a comment's replies away. -->
    <string name="comments_hide_replies">Nascondi risposte</string>
    <!-- Text button that opens a comment's replies. %1$s = how many. -->
    <plurals name="comments_replies">
        <item quantity="one">%1$s risposta</item>
        <item quantity="many">%1$s risposte</item>
        <item quantity="other">%1$s risposte</item>
    </plurals>
    <!-- Author shown on a comment the person just posted, until the page reloads. -->
    <string name="comments_you">Tu</string>
    <!-- Errors shown under the comment box. -->
    <string name="comments_error_like">Impossibile mettere Mi piace al commento.</string>
    <string name="comments_error_post">Impossibile pubblicare il commento.</string>
    <string name="comments_error_cant_post">I commenti sono disattivati o non si possono pubblicare su questo video.</string>
    <string name="comments_error_reply_not_found">Impossibile trovare il commento a cui rispondere. Riprova.</string>
    <string name="comments_error_like_not_found">Impossibile trovare il commento a cui mettere Mi piace. Riprova.</string>
    <string name="comments_error_not_accepted">YouTube non ha accettato il commento.</string>

    <!-- ── Captions ─────────────────────────────────────────────────────────── -->

    <!-- Title of the captions sheet and of the captions card in settings. -->
    <string name="captions_title">Sottotitoli</string>
    <!-- Title of the transcript panel and the button that opens it. -->
    <string name="captions_transcript">Trascrizione</string>
    <!-- Shown over the video while a translation model downloads. %1$s = a language name ("German"). -->
    <string name="captions_downloading_language">Download di %1$s per la traduzione…</string>
    <!-- Shown over the video while captions are being translated. %1$s = a language name. -->
    <string name="captions_translating_into">Traduzione in %1$s…</string>
    <!-- Error over the video / in the transcript. %1$s = a language name. -->
    <string name="captions_error_download">Impossibile scaricare %1$s per la traduzione.</string>
    <string name="captions_error_load">Impossibile caricare questi sottotitoli.</string>
    <!-- Note after a caption track's language in the list: captions YouTube made itself from speech. -->
    <string name="captions_auto_generated">generati automaticamente</string>
    <!-- Short form of "auto-generated", in a small chip next to the transcript's title, keep short. -->
    <string name="captions_auto">auto</string>
    <!-- Notes after a translation language in the list. -->
    <string name="captions_note_downloading">download in corso…</string>
    <!-- %1$s = the language translated from ("from English"). -->
    <string name="captions_note_from">da %1$s</string>
    <!-- The translation model still has to be downloaded; "MB" = megabytes. -->
    <string name="captions_note_download_size">download di ~30 MB</string>
    <!-- Section heading in the captions list (shown in capitals): the languages that are translated by the phone itself. -->
    <string name="captions_translated_on_phone">TRADOTTI SUL TUO TELEFONO</string>
    <!-- Row at the end of the captions list that shows every language. -->
    <string name="captions_more_languages">Altre lingue</string>
    <string name="captions_none">Questo video non ha sottotitoli.</string>
    <!-- Accessibility label of the check on the chosen row. -->
    <string name="captions_selected">Selezionato</string>
    <!-- Accessibility label of the transcript panel's close (X) button. -->
    <string name="captions_close_transcript">Chiudi la trascrizione</string>
    <string name="captions_no_transcript">Questo video non ha sottotitoli, quindi non c\'è una trascrizione.</string>
    <string name="captions_no_lines">Ancora nessuna riga.</string>
    <!-- Transcript search found nothing. %1$s = what was typed. -->
    <string name="captions_nothing_matches">Nessun risultato per \"%1$s\".</string>
    <!-- Button that scrolls the transcript back to the line being said. -->
    <string name="captions_back_to_now">Torna al punto attuale</string>
    <!-- Placeholder of the transcript's search field. -->
    <string name="captions_search_transcript">Cerca nella trascrizione</string>
    <!-- Accessibility label of the X that clears the search. -->
    <string name="captions_clear_search">Cancella ricerca</string>

    <!-- Settings card (account sheet). -->
    <string name="captions_settings_subtitle">Scegli una lingua o disattivali nel player</string>
    <!-- A sample caption in the settings preview, shown as two lines over a picture: this is the first line… -->
    <string name="captions_sample_line_1">Ecco come appariranno</string>
    <!-- …and this the second. Split the sentence about evenly. -->
    <string name="captions_sample_line_2">i sottotitoli sul video.</string>
    <!-- Setting label, then its choice chips. -->
    <string name="captions_show">Mostra sottotitoli</string>
    <string name="captions_show_never">Mai</string>
    <string name="captions_show_always">Sempre</string>
    <!-- Chip: show captions only when the video's language differs from the app's. %1$s = the app's language ("English"). -->
    <string name="captions_show_foreign">Se non è in %1$s</string>
    <!-- Setting label: the style captions are drawn in. -->
    <string name="captions_look">Aspetto</string>
    <!-- Caption style chips: a plain black box, white text with a black outline, and Android's own caption settings. -->
    <string name="captions_look_classic">Classico</string>
    <string name="captions_look_outline">Contorno</string>
    <string name="captions_look_system">Di Android</string>
    <!-- Setting label: caption text size, then its chips. -->
    <string name="captions_size">Dimensioni</string>
    <string name="captions_size_small">Piccole</string>
    <string name="captions_size_medium">Medie</string>
    <string name="captions_size_large">Grandi</string>
    <string name="captions_size_huge">Enormi</string>
    <!-- Setting label over the downloaded translation languages (each with an X to delete it). -->
    <string name="captions_kept_languages">Lingue di traduzione su questo telefono</string>
    <!-- Accessibility label of a downloaded language's X. %1$s = the language. -->
    <string name="captions_remove_language">Rimuovi %1$s</string>
</resources>
