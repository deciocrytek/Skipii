    <string name="ui_back">Kembali</string>
    <!-- Button that closes a page or message. -->
    <string name="ui_close">Tutup</string>
    <!-- Button, ~20 characters: opens Google's sign-in page. -->
    <string name="ui_sign_in_with_google">Login dengan Google</string>
    <!-- Name of the account's built-in playlist of videos saved for later (YouTube's "Watch later"). -->
    <string name="ui_watch_later">Tonton Nanti</string>
    <!-- Name of the account's built-in playlist of liked videos. -->
    <string name="ui_liked_videos">Video yang disukai</string>

    <!-- ── Long-press options on a video ──────────────────────────────────── -->
    <string name="ui_play_next">Putar berikutnya</string>
    <string name="ui_add_to_queue">Tambahkan ke antrean</string>
    <string name="ui_save_to_watch_later">Simpan ke Tonton Nanti</string>
