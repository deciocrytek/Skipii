    <string name="ui_shorts">Shorts</string>
    <string name="ui_shorts_on_line">Tampilkan tab Shorts</string>
    <string name="ui_shorts_off_line">Tab Shorts disembunyikan dan Shorts tidak dimuat</string>
    <string name="ui_appearance">Tampilan</string>
