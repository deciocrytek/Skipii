    <!-- Card under the player: "Queue · 3" = 3 videos queued (%1$s). Keep short. -->
    <plurals name="ui_queue_count">
        <item quantity="other">Antrean · %1$s</item>
    </plurals>
    <!-- Small button (~8 characters) that empties the queue. -->
    <string name="ui_clear">Hapus</string>
    <!-- Title of the queue sheet. -->
    <string name="ui_queue">Antrean</string>
    <!-- Accessibility label of the X on a queued video. -->
    <string name="ui_remove_from_queue">Hapus dari antrean</string>
    <string name="ui_queue_empty">Antrean kosong. Tekan lama video untuk menambahkannya.</string>

    <!-- ── Account sheet: settings ────────────────────────────────────────── -->
    <!-- Line under the SponsorBlock switch. -->
    <string name="ui_sponsorblock_line">Lewati promosi sponsor dan segmen lainnya</string>
    <!-- Required credit under the SponsorBlock settings; keep "sponsor.ajay.app" and "CC BY-NC-SA 4.0" as they are. -->
    <string name="ui_sponsorblock_credit">Segmen dari SponsorBlock (sponsor.ajay.app), proyek komunitas. Data berlisensi CC BY-NC-SA 4.0.</string>
    <string name="ui_player_controls">Kontrol pemutar</string>
