<resources>
    <!-- Bottom tab bar labels (MainActivity Tab, drawn by NavBar). Tight: the selected tab shows its label
         beside the icon in a shared pill; keep as short as possible (~12 characters). -->
    <string name="app_tab_home">Beranda</string>
    <string name="app_tab_subscriptions">Langganan</string>
    <!-- YouTube's name for its short vertical videos; most languages keep "Shorts". -->
    <string name="app_tab_shorts">Shorts</string>
    <string name="app_tab_search">Telusuri</string>
    <string name="app_tab_library">Koleksi</string>

    <!-- Self-update: the Update pill in Home's header, beside the profile picture. Short (~10 characters). -->
    <string name="app_update_pill">Update</string>
    <!-- Update pill while installing. Short (~10 characters). -->
    <string name="app_update_pill_installing">Memasang</string>
    <!-- Update pill after a failed download/install. Short (~10 characters). -->
    <string name="app_update_pill_retry">Coba lagi</string>
    <!-- Download progress, %1$s is a whole number 0-100 ("42%"). -->
    <string name="app_update_percent">%1$s%%</string>
    <!-- Title of the "What's new" sheet listing the release notes of a new version. -->
    <string name="app_update_whats_new">Yang baru</string>
    <!-- Download size of the new version, %1$s is a number with one decimal ("16.8"). -->
    <string name="app_update_size_mb">%1$s MB</string>
    <string name="app_update_no_notes">Tidak ada catatan yang dipublikasikan untuk versi ini.</string>
    <!-- The What's new sheet's full-width button. -->
    <string name="app_update_button">Update</string>
    <!-- The sheet's button while downloading, %1$s is a whole number 0-100. -->
    <string name="app_update_downloading">Mendownload %1$s%%</string>
    <string name="app_update_installing">Memasang…</string>
    <string name="app_update_try_again">Coba lagi</string>
    <!-- Notification channel name (Android Settings › Notifications). -->
    <string name="app_update_channel">Update aplikasi</string>
    <!-- Notification after the app updated itself, %1$s is the version ("0.5.79"). -->
    <string name="app_updated_title">Skipii diupdate ke %1$s</string>
    <string name="app_updated_text">Ketuk untuk membuka</string>

    <!-- The Subscribe button (player and channel page). Short: shares a row with the bell key. -->
    <string name="app_subscribe">Subscribe</string>
    <string name="app_subscribed">Disubscribe</string>
    <!-- Accessibility labels of the bell key next to Subscribed. -->
    <string name="app_bell_on_description">Lonceng aktif: setiap video baru. Ketuk untuk menonaktifkan</string>
    <string name="app_bell_off_description">Lonceng: dapatkan notifikasi untuk setiap video baru</string>
    <!-- Messages after turning a channel's bell on/off. %1$s is the channel's name. -->
    <string name="app_bell_on_message">Setiap video baru dari %1$s</string>
    <string name="app_bell_off_message">Notifikasi nonaktif untuk %1$s</string>
    <!-- Same, when the channel's name isn't known. -->
    <string name="app_bell_on_message_unnamed">Setiap video baru dari channel ini</string>
    <string name="app_bell_off_message_unnamed">Notifikasi nonaktif untuk channel ini</string>
    <string name="app_bell_failed">Tidak dapat mengubah lonceng.</string>
    <!-- Notifications were refused when asked (Android 13+). -->
    <string name="app_bell_allow_notifications">Izinkan notifikasi Skipii untuk menggunakan lonceng.</string>
    <!-- Notifications are off in Android's settings; the settings page opens next. -->
    <string name="app_bell_turn_on_notifications">Aktifkan notifikasi Skipii untuk menggunakan lonceng.</string>

    <!-- Notification channel for new videos from channels with the bell on (Android Settings › Notifications). -->
    <string name="app_new_videos_channel">Video baru</string>
    <string name="app_new_videos_channel_description">Setiap video baru dari channel yang loncengnya aktif</string>
    <!-- A new-video notification's title when the channel's name isn't known. -->
    <string name="app_new_video_unnamed">Video baru</string>

    <!-- The signed-in account's name when Google's page didn't give one. -->
    <string name="app_account_fallback_name">Akun YouTube</string>
    <!-- Errors shown on the signed-in feeds. %1$s is an HTTP status code ("403"). -->
    <string name="app_error_session_rejected">YouTube menolak sesi (%1$s). Coba login lagi.</string>
    <string name="app_error_youtube_returned">YouTube mengembalikan %1$s</string>
    <!-- The live activity's notification channel, and its skip buttons. %1$s = seconds ("10"). -->
    <string name="app_live_channel">Diputar di latar belakang</string>
    <string name="app_live_channel_description">Kontrol pemutaran saat Skipii tidak di layar</string>
    <string name="app_live_back">−%1$s dtk</string>
    <string name="app_live_forward">+%1$s dtk</string>
</resources>
