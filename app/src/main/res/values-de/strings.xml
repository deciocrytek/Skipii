        <item quantity="one">%1$s Aufruf</item>
        <item quantity="other">%1$s Aufrufe</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="one">%1$s Abonnent</item>
        <item quantity="other">%1$s Abonnenten</item>
    </plurals>

