<resources>
    <!-- ── Portrait player page (PlayerUi.kt) ── -->

    <!-- Tappable word after the video's stats line ("1.2M views · 3 days ago"), opens / closes the description. Keep short. -->
    <string name="player_description_more">…más</string>
    <string name="player_description_less">menos</string>
    <!-- Part of the stats line under the title. %1$s is a compact count ("1.2M"); the quantity is the exact count. -->
    <plurals name="player_likes">
        <item quantity="one">%1$s me gusta</item>
        <item quantity="many">%1$s me gusta</item>
        <item quantity="other">%1$s me gusta</item>
    </plurals>
    <!-- Section title above the related videos list under the player. -->
    <string name="player_more_videos">Más videos</string>
    <!-- Pill button in the player's action row (label and accessibility label). Keep short. -->
    <string name="player_share">Compartir</string>
    <!-- Pill button in the player's action row: opens every line of the captions. Keep short. -->
    <string name="player_transcript">Transcripción</string>
    <!-- Pill button in the player's action row: opens the "Save to playlist" sheet. Keep short. -->
    <string name="player_playlist">Lista</string>
    <!-- Accessibility labels of the action row's buttons. -->
    <string name="player_like">Me gusta</string>
    <string name="player_dislike">No me gusta</string>
    <string name="player_save_to_playlist">Guardar en lista de reproducción</string>
    <!-- Accessibility label of the mini-player's close (X) button. -->
    <string name="player_close">Cerrar</string>

    <!-- ── Short notes shown at the bottom of the player after an action (PlayerState.kt) ── -->
    <string name="player_playing_next">Se reproducirá a continuación</string>
    <string name="player_added_to_queue">Agregado a la cola</string>
    <string name="player_like_failed">No se pudo actualizar tu me gusta.</string>
    <string name="player_subscribe_failed">No se pudo actualizar tu suscripción.</string>
    <!-- "Watch later" is YouTube's own playlist name. -->
    <string name="player_saved_watch_later">Guardado en Ver más tarde</string>
    <string name="player_watch_later_failed">No se pudo guardar en Ver más tarde.</string>
    <!-- %1$s is a playlist's name. -->
    <string name="player_saved_to">Guardado en %1$s</string>
    <!-- %1$s is a playlist's name. -->
    <string name="player_removed_from">Se quitó de %1$s</string>
