<resources>
    <!-- ── Comments ─────────────────────────────────────────────────────────── -->

    <!-- Title of the comments card under the video and of the comments panel. -->
    <string name="comments_title">Comentarios</string>
    <string name="comments_turned_off">Los comentarios están desactivados en este video.</string>
    <!-- Comments card, signed in, when the video has no comments yet. -->
    <string name="comments_none_add_first">Aún no hay comentarios. Escribe el primero.</string>
    <string name="comments_none">Aún no hay comentarios.</string>
    <!-- Accessibility label of the panel's close (X) button. -->
    <string name="comments_close">Cerrar comentarios</string>
    <!-- Shown at the bottom of the comments panel instead of the comment box when signed out. -->
    <string name="comments_sign_in_to_comment">Inicia sesión para comentar.</string>
    <!-- Above the comment box while replying. %1$s = the name of the person replied to. -->
    <string name="comments_replying_to">Respondiendo a %1$s</string>
    <!-- Accessibility label of the X that stops replying. -->
    <string name="comments_cancel_reply">Cancelar respuesta</string>
    <!-- Placeholder in the comment box. -->
    <string name="comments_add_reply">Escribe una respuesta…</string>
    <string name="comments_add_comment">Escribe un comentario…</string>
    <!-- Accessibility label of the send button (posts the comment). -->
    <string name="comments_post">Publicar</string>
    <!-- Accessibility label of the pin icon on a pinned comment. -->
    <string name="comments_pinned">Fijado</string>
    <!-- Accessibility labels of a comment's thumbs-up button. -->
    <string name="comments_like">Me gusta</string>
    <string name="comments_unlike">Quitar me gusta</string>
    <!-- Accessibility label of the heart the video's creator gave a comment. -->
    <string name="comments_hearted">Con corazón del creador</string>
    <!-- Small text button under a comment, keep short. -->
    <string name="comments_reply">Responder</string>
    <!-- Text button that folds a comment's replies away. -->
    <string name="comments_hide_replies">Ocultar respuestas</string>
    <!-- Text button that opens a comment's replies. %1$s = how many. -->
    <plurals name="comments_replies">
        <item quantity="one">%1$s respuesta</item>
        <item quantity="many">%1$s respuestas</item>
        <item quantity="other">%1$s respuestas</item>
    </plurals>
    <!-- Author shown on a comment the person just posted, until the page reloads. -->
    <string name="comments_you">Tú</string>
    <!-- Errors shown under the comment box. -->
    <string name="comments_error_like">No se pudo dar me gusta a ese comentario.</string>
    <string name="comments_error_post">No se pudo publicar tu comentario.</string>
    <string name="comments_error_cant_post">Los comentarios están desactivados o no se pueden publicar en este video.</string>
    <string name="comments_error_reply_not_found">No se encontró ese comentario para responderlo. Vuelve a intentarlo.</string>
    <string name="comments_error_like_not_found">No se encontró ese comentario para darle me gusta. Vuelve a intentarlo.</string>
    <string name="comments_error_not_accepted">YouTube no aceptó el comentario.</string>

    <!-- ── Captions ─────────────────────────────────────────────────────────── -->

    <!-- Title of the captions sheet and of the captions card in settings. -->
    <string name="captions_title">Subtítulos</string>
    <!-- Title of the transcript panel and the button that opens it. -->
    <string name="captions_transcript">Transcripción</string>
    <!-- Shown over the video while a translation model downloads. %1$s = a language name ("German"). -->
    <string name="captions_downloading_language">Descargando el idioma %1$s para traducir…</string>
    <!-- Shown over the video while captions are being translated. %1$s = a language name. -->
    <string name="captions_translating_into">Traduciendo al %1$s…</string>
    <!-- Error over the video / in the transcript. %1$s = a language name. -->
    <string name="captions_error_download">No se pudo descargar el idioma %1$s para traducir.</string>
    <string name="captions_error_load">No se pudieron cargar estos subtítulos.</string>
    <!-- Note after a caption track's language in the list: captions YouTube made itself from speech. -->
    <string name="captions_auto_generated">generados automáticamente</string>
    <!-- Short form of "auto-generated", in a small chip next to the transcript's title, keep short. -->
    <string name="captions_auto">auto</string>
    <!-- Notes after a translation language in the list. -->
    <string name="captions_note_downloading">descargando…</string>
    <!-- %1$s = the language translated from ("from English"). -->
    <string name="captions_note_from">del %1$s</string>
    <!-- The translation model still has to be downloaded; "MB" = megabytes. -->
    <string name="captions_note_download_size">descarga de ~30 MB</string>
    <!-- Section heading in the captions list (shown in capitals): the languages that are translated by the phone itself. -->
    <string name="captions_translated_on_phone">TRADUCIDOS EN TU TELÉFONO</string>
    <!-- Row at the end of the captions list that shows every language. -->
    <string name="captions_more_languages">Más idiomas</string>
    <string name="captions_none">Este video no tiene subtítulos.</string>
    <!-- Accessibility label of the check on the chosen row. -->
    <string name="captions_selected">Seleccionado</string>
    <!-- Accessibility label of the transcript panel's close (X) button. -->
    <string name="captions_close_transcript">Cerrar transcripción</string>
    <string name="captions_no_transcript">Este video no tiene subtítulos, así que no hay transcripción.</string>
    <string name="captions_no_lines">Aún no hay líneas.</string>
    <!-- Transcript search found nothing. %1$s = what was typed. -->
    <string name="captions_nothing_matches">Nada coincide con \"%1$s\".</string>
    <!-- Button that scrolls the transcript back to the line being said. -->
    <string name="captions_back_to_now">Volver al momento actual</string>
    <!-- Placeholder of the transcript's search field. -->
    <string name="captions_search_transcript">Buscar en la transcripción</string>
    <!-- Accessibility label of the X that clears the search. -->
    <string name="captions_clear_search">Borrar búsqueda</string>

    <!-- Settings card (account sheet). -->
    <string name="captions_settings_subtitle">Elige un idioma o desactívalos en el reproductor</string>
    <!-- A sample caption in the settings preview, shown as two lines over a picture: this is the first line… -->
    <string name="captions_sample_line_1">Los subtítulos se verán</string>
    <!-- …and this the second. Split the sentence about evenly. -->
    <string name="captions_sample_line_2">así sobre el video.</string>
    <!-- Setting label, then its choice chips. -->
    <string name="captions_show">Mostrar subtítulos</string>
    <string name="captions_show_never">Nunca</string>
    <string name="captions_show_always">Siempre</string>
    <!-- Chip: show captions only when the video's language differs from the app's. %1$s = the app's language ("English"). -->
    <string name="captions_show_foreign">Si no está en %1$s</string>
    <!-- Setting label: the style captions are drawn in. -->
    <string name="captions_look">Aspecto</string>
    <!-- Caption style chips: a plain black box, white text with a black outline, and Android's own caption settings. -->
    <string name="captions_look_classic">Clásico</string>
    <string name="captions_look_outline">Contorno</string>
    <string name="captions_look_system">De Android</string>
    <!-- Setting label: caption text size, then its chips. -->
    <string name="captions_size">Tamaño</string>
    <string name="captions_size_small">Pequeño</string>
    <string name="captions_size_medium">Mediano</string>
    <string name="captions_size_large">Grande</string>
    <string name="captions_size_huge">Enorme</string>
    <!-- Setting label over the downloaded translation languages (each with an X to delete it). -->
    <string name="captions_kept_languages">Idiomas de traducción en este teléfono</string>
    <!-- Accessibility label of a downloaded language's X. %1$s = the language. -->
    <string name="captions_remove_language">Quitar %1$s</string>
</resources>
