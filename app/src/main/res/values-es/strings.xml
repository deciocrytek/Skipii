<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s mil</string>
    <string name="count_millions">%1$s M</string>
    <string name="count_billions">%1$s mil M</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1.2M"); the quantity is the exact count. -->
    <plurals name="views_count">
        <item quantity="one">%1$s visualización</item>
        <item quantity="many">%1$s de visualizaciones</item>
        <item quantity="other">%1$s visualizaciones</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="one">%1$s suscriptor</item>
        <item quantity="many">%1$s de suscriptores</item>
        <item quantity="other">%1$s suscriptores</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("3 days ago"). -->
    <string name="age_just_now">hace un momento</string>
    <string name="age_streamed">Transmitido %1$s</string>
    <string name="age_premiered">Estrenado %1$s</string>

    <!-- The account sheet's Language card (LanguageSettings). -->
    <string name="language_title">Idioma</string>
    <string name="language_phone">Idioma del teléfono</string>
    <!-- %1$s is the language's own name ("Español"). -->
    <string name="language_phone_named">Idioma del teléfono (%1$s)</string>
    <string name="language_line">Solo cambia los textos de la app. Los videos, títulos y comentarios se quedan como los escribieron sus creadores.</string>
</resources>
