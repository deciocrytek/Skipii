    <string name="ui_remove_from_queue">キューから削除</string>
    <string name="ui_queue_empty">キューは空です。動画を長押しすると追加できます。</string>

    <!-- ── Account sheet: settings ────────────────────────────────────────── -->
    <!-- Line under the SponsorBlock switch. -->
    <string name="ui_sponsorblock_line">スポンサー紹介などの区間をスキップ</string>
    <!-- Required credit under the SponsorBlock settings; keep "sponsor.ajay.app" and "CC BY-NC-SA 4.0" as they are. -->
    <string name="ui_sponsorblock_credit">区間データはコミュニティプロジェクト SponsorBlock（sponsor.ajay.app）によるものです。データのライセンスは CC BY-NC-SA 4.0 です。</string>
