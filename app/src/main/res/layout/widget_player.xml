<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget (0.6.0, Neon's spec): now playing with −step · play · +step and its progress, then Continue watching. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="15dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_brand" />
        <TextView
            android:id="@+id/w_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxLines="1"
            android:textColor="@color/widget_on_var"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_thumb"
            android:layout_width="104dp"
            android:layout_height="58dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_on"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_var"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/w_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
    <LinearLayout
        android:id="@+id/w_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/w_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_round_bg"
            android:contentDescription="@string/widget_back">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_back" />
            <TextView
                android:id="@+id/w_back_n"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingTop="2dp"
                android:importantForAccessibility="no"
                android:textColor="@color/widget_on"
                android:textSize="7sp"
                android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_play"
            android:layout_width="96dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_play_bg">
            <ImageView
                android:id="@+id/w_play_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_fwd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_round_bg"
            android:contentDescription="@string/widget_forward">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_forward" />
            <TextView
                android:id="@+id/w_fwd_n"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingTop="2dp"
                android:importantForAccessibility="no"
                android:textColor="@color/widget_on"
                android:textSize="7sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_nothing"
        android:textColor="@color/widget_on"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/w_cont_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_continue"
        android:textColor="@color/widget_on_var"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/w_cont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_c0_thumb"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/w_c0_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_on_var"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_c1_thumb"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/w_c1_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_on_var"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_c2_thumb"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/w_c2_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_on_var"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
