    <string name="player_like">Thích</string>
    <string name="player_dislike">Không thích</string>
    <string name="player_save_to_playlist">Lưu vào danh sách phát</string>
    <!-- Accessibility label of the mini-player's close (X) button. -->
    <string name="player_close">Đóng</string>

