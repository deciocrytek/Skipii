<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s N</string>
    <string name="count_millions">%1$s Tr</string>
    <string name="count_billions">%1$s T</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1.2M"); the quantity is the exact count. -->
    <plurals name="views_count">
        <item quantity="other">%1$s lượt xem</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="other">%1$s người đăng ký</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("3 days ago"). -->
    <string name="age_just_now">vừa xong</string>
    <string name="age_streamed">Đã phát trực tiếp %1$s</string>
    <string name="age_premiered">Đã công chiếu %1$s</string>

    <!-- The account sheet's Language card (LanguageSettings). -->
    <string name="language_title">Ngôn ngữ</string>
    <string name="language_phone">Ngôn ngữ của điện thoại</string>
    <!-- %1$s is the language's own name ("Español"). -->
    <string name="language_phone_named">Ngôn ngữ của điện thoại (%1$s)</string>
    <string name="language_line">Chỉ đổi chữ của ứng dụng. Video, tiêu đề và bình luận vẫn giữ nguyên như người tạo đã viết.</string>
</resources>
