    <string name="comments_sign_in_to_comment">Đăng nhập để bình luận.</string>
    <!-- Above the comment box while replying. %1$s = the name of the person replied to. -->
    <string name="comments_replying_to">Đang trả lời %1$s</string>
    <!-- Accessibility label of the X that stops replying. -->
    <string name="comments_cancel_reply">Hủy trả lời</string>
    <!-- Placeholder in the comment box. -->
    <string name="comments_add_reply">Thêm câu trả lời…</string>
    <string name="comments_add_comment">Viết bình luận…</string>
    <!-- Accessibility label of the send button (posts the comment). -->
    <string name="comments_post">Đăng</string>
    <!-- Accessibility label of the pin icon on a pinned comment. -->
    <string name="comments_pinned">Đã ghim</string>
    <!-- Accessibility labels of a comment's thumbs-up button. -->
    <string name="comments_like">Thích</string>
    <string name="comments_unlike">Bỏ thích</string>
    <!-- Accessibility label of the heart the video's creator gave a comment. -->
    <string name="comments_hearted">Được người sáng tạo thả tim</string>
    <!-- Small text button under a comment, keep short. -->
    <string name="comments_reply">Trả lời</string>
    <!-- Text button that folds a comment's replies away. -->
    <string name="comments_hide_replies">Ẩn câu trả lời</string>
