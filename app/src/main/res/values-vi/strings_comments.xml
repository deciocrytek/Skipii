<resources>
    <!-- ── Comments ─────────────────────────────────────────────────────────── -->

    <!-- Title of the comments card under the video and of the comments panel. -->
    <string name="comments_title">Bình luận</string>
    <string name="comments_turned_off">Video này đã tắt tính năng bình luận.</string>
    <!-- Comments card, signed in, when the video has no comments yet. -->
    <string name="comments_none_add_first">Chưa có bình luận nào. Hãy là người đầu tiên bình luận.</string>
    <string name="comments_none">Chưa có bình luận nào.</string>
    <!-- Accessibility label of the panel's close (X) button. -->
    <string name="comments_close">Đóng bình luận</string>
