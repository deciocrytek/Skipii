    <plurals name="comments_replies">
        <item quantity="other">%1$s câu trả lời</item>
    </plurals>
    <!-- Author shown on a comment the person just posted, until the page reloads. -->
    <string name="comments_you">Bạn</string>
    <!-- Errors shown under the comment box. -->
    <string name="comments_error_like">Không thể thích bình luận đó.</string>
    <string name="comments_error_post">Không thể đăng bình luận của bạn.</string>
    <string name="comments_error_cant_post">Video này đã tắt bình luận hoặc không thể đăng bình luận.</string>
    <string name="comments_error_reply_not_found">Không tìm thấy bình luận để trả lời. Hãy thử lại.</string>
    <string name="comments_error_like_not_found">Không tìm thấy bình luận để thích. Hãy thử lại.</string>
    <string name="comments_error_not_accepted">YouTube không chấp nhận bình luận này.</string>

    <!-- ── Captions ─────────────────────────────────────────────────────────── -->

    <!-- Title of the captions sheet and of the captions card in settings. -->
    <string name="captions_title">Phụ đề</string>
    <!-- Title of the transcript panel and the button that opens it. -->
    <string name="captions_transcript">Bản chép lời</string>
    <!-- Shown over the video while a translation model downloads. %1$s = a language name ("German"). -->
    <string name="captions_downloading_language">Đang tải xuống %1$s để dịch…</string>
    <!-- Shown over the video while captions are being translated. %1$s = a language name. -->
    <string name="captions_translating_into">Đang dịch sang %1$s…</string>
    <!-- Error over the video / in the transcript. %1$s = a language name. -->
    <string name="captions_error_download">Không thể tải xuống %1$s để dịch.</string>
    <string name="captions_error_load">Không thể tải phụ đề này.</string>
    <!-- Note after a caption track's language in the list: captions YouTube made itself from speech. -->
    <string name="captions_auto_generated">tự động tạo</string>
    <!-- Short form of "auto-generated", in a small chip next to the transcript's title, keep short. -->
    <string name="captions_auto">tự động</string>
    <!-- Notes after a translation language in the list. -->
    <string name="captions_note_downloading">đang tải xuống…</string>
    <!-- %1$s = the language translated from ("from English"). -->
    <string name="captions_note_from">từ %1$s</string>
    <!-- The translation model still has to be downloaded; "MB" = megabytes. -->
    <string name="captions_note_download_size">cần tải ~30 MB</string>
    <!-- Section heading in the captions list (shown in capitals): the languages that are translated by the phone itself. -->
    <string name="captions_translated_on_phone">DỊCH TRÊN ĐIỆN THOẠI</string>
    <!-- Row at the end of the captions list that shows every language. -->
    <string name="captions_more_languages">Ngôn ngữ khác</string>
    <string name="captions_none">Video này không có phụ đề.</string>
    <!-- Accessibility label of the check on the chosen row. -->
    <string name="captions_selected">Đã chọn</string>
    <!-- Accessibility label of the transcript panel's close (X) button. -->
    <string name="captions_close_transcript">Đóng bản chép lời</string>
    <string name="captions_no_transcript">Video này không có phụ đề nên không có bản chép lời.</string>
    <string name="captions_no_lines">Chưa có dòng nào.</string>
    <!-- Transcript search found nothing. %1$s = what was typed. -->
    <string name="captions_nothing_matches">Không có kết quả nào khớp với \"%1$s\".</string>
    <!-- Button that scrolls the transcript back to the line being said. -->
    <string name="captions_back_to_now">Về vị trí hiện tại</string>
    <!-- Placeholder of the transcript's search field. -->
    <string name="captions_search_transcript">Tìm trong bản chép lời</string>
    <!-- Accessibility label of the X that clears the search. -->
    <string name="captions_clear_search">Xóa nội dung tìm kiếm</string>

    <!-- Settings card (account sheet). -->
    <string name="captions_settings_subtitle">Chọn ngôn ngữ hoặc tắt phụ đề trong trình phát</string>
    <!-- A sample caption in the settings preview, shown as two lines over a picture: this is the first line… -->
    <string name="captions_sample_line_1">Phụ đề sẽ hiển thị</string>
    <!-- …and this the second. Split the sentence about evenly. -->
    <string name="captions_sample_line_2">trên video như thế này.</string>
    <!-- Setting label, then its choice chips. -->
    <string name="captions_show">Hiện phụ đề</string>
    <string name="captions_show_never">Không bao giờ</string>
    <string name="captions_show_always">Luôn luôn</string>
    <!-- Chip: show captions only when the video's language differs from the app's. %1$s = the app's language ("English"). -->
    <string name="captions_show_foreign">Khi không phải %1$s</string>
    <!-- Setting label: the style captions are drawn in. -->
    <string name="captions_look">Kiểu</string>
    <!-- Caption style chips: a plain black box, white text with a black outline, and Android's own caption settings. -->
    <string name="captions_look_classic">Cổ điển</string>
    <string name="captions_look_outline">Viền chữ</string>
    <string name="captions_look_system">Của Android</string>
    <!-- Setting label: caption text size, then its chips. -->
    <string name="captions_size">Cỡ chữ</string>
    <string name="captions_size_small">Nhỏ</string>
    <string name="captions_size_medium">Vừa</string>
    <string name="captions_size_large">Lớn</string>
    <string name="captions_size_huge">Rất lớn</string>
    <!-- Setting label over the downloaded translation languages (each with an X to delete it). -->
    <string name="captions_kept_languages">Ngôn ngữ dịch trên điện thoại này</string>
    <!-- Accessibility label of a downloaded language's X. %1$s = the language. -->
    <string name="captions_remove_language">Xóa %1$s</string>
</resources>
