<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s ألف</string>
    <string name="count_millions">%1$s مليون</string>
    <string name="count_billions">%1$s مليار</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. Unused in Arabic, kept unchanged. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1.2M"); the quantity is the exact count.
         "few" (n % 100 = 3..10) also hits big compacted counts ("1.2 مليون"), so it keeps the singular form that
         reads right after ألف / مليون. -->
    <plurals name="views_count">
        <item quantity="zero">%1$s مشاهدة</item>
        <item quantity="one">%1$s مشاهدة</item>
        <item quantity="two">مشاهدتان</item>
        <item quantity="few">%1$s مشاهدات</item>
        <item quantity="many">%1$s مشاهدة</item>
        <item quantity="other">%1$s مشاهدة</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="zero">%1$s مشترك</item>
        <item quantity="one">%1$s مشترك</item>
        <item quantity="two">مشتركان</item>
        <item quantity="few">%1$s مشتركين</item>
        <item quantity="many">%1$s مشتركًا</item>
        <item quantity="other">%1$s مشترك</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("3 days ago"). -->
