<resources>
    <!-- Bottom tab bar labels (MainActivity Tab, drawn by NavBar). Tight: the selected tab shows its label
         beside the icon in a shared pill; keep as short as possible (~12 characters). -->
    <string name="app_tab_home">الرئيسية</string>
    <string name="app_tab_subscriptions">الاشتراكات</string>
    <!-- YouTube's name for its short vertical videos; most languages keep "Shorts". -->
    <string name="app_tab_shorts">Shorts</string>
    <string name="app_tab_search">بحث</string>
    <string name="app_tab_library">المكتبة</string>

    <!-- Self-update: the Update pill in Home's header, beside the profile picture. Short (~10 characters). -->
    <string name="app_update_pill">تحديث</string>
    <!-- Update pill while installing. Short (~10 characters). -->
    <string name="app_update_pill_installing">جارٍ التثبيت</string>
    <!-- Update pill after a failed download/install. Short (~10 characters). -->
    <string name="app_update_pill_retry">أعد المحاولة</string>
    <!-- Download progress, %1$s is a whole number 0-100 ("42%"). -->
    <string name="app_update_percent">%1$s%%</string>
    <!-- Title of the "What's new" sheet listing the release notes of a new version. -->
    <string name="app_update_whats_new">ما الجديد</string>
    <!-- Download size of the new version, %1$s is a number with one decimal ("16.8"). -->
    <string name="app_update_size_mb">%1$s ميغابايت</string>
    <string name="app_update_no_notes">لم تُنشر أي ملاحظات مع هذا الإصدار.</string>
    <!-- The What's new sheet's full-width button. -->
    <string name="app_update_button">تحديث</string>
    <!-- The sheet's button while downloading, %1$s is a whole number 0-100. -->
    <string name="app_update_downloading">جارٍ التنزيل %1$s%%</string>
    <string name="app_update_installing">جارٍ التثبيت…</string>
    <string name="app_update_try_again">إعادة المحاولة</string>
    <!-- Notification channel name (Android Settings › Notifications). -->
    <string name="app_update_channel">تحديثات التطبيق</string>
    <!-- Notification after the app updated itself, %1$s is the version ("0.5.79"). -->
    <string name="app_updated_title">تم تحديث Skipii إلى الإصدار %1$s</string>
    <string name="app_updated_text">انقر للفتح</string>

    <!-- The Subscribe button (player and channel page). Short: shares a row with the bell key. -->
    <string name="app_subscribe">اشتراك</string>
    <string name="app_subscribed">تم الاشتراك</string>
    <!-- Accessibility labels of the bell key next to Subscribed. -->
    <string name="app_bell_on_description">الجرس مفعّل: كل فيديو جديد. انقر لإيقافه</string>
    <string name="app_bell_off_description">الجرس: تلقَّ إشعارًا بكل فيديو جديد</string>
    <!-- Messages after turning a channel's bell on/off. %1$s is the channel's name. -->
    <string name="app_bell_on_message">كل فيديو جديد من %1$s</string>
    <string name="app_bell_off_message">تم إيقاف الإشعارات من %1$s</string>
    <!-- Same, when the channel's name isn't known. -->
    <string name="app_bell_on_message_unnamed">كل فيديو جديد من هذه القناة</string>
    <string name="app_bell_off_message_unnamed">تم إيقاف الإشعارات من هذه القناة</string>
    <string name="app_bell_failed">تعذّر تغيير الجرس.</string>
    <!-- Notifications were refused when asked (Android 13+). -->
    <string name="app_bell_allow_notifications">اسمح بإشعارات Skipii لاستخدام الجرس.</string>
    <!-- Notifications are off in Android's settings; the settings page opens next. -->
    <string name="app_bell_turn_on_notifications">فعِّل إشعارات Skipii لاستخدام الجرس.</string>

    <!-- Notification channel for new videos from channels with the bell on (Android Settings › Notifications). -->
    <string name="app_new_videos_channel">فيديوهات جديدة</string>
    <string name="app_new_videos_channel_description">كل فيديو جديد من القنوات التي فعّلت جرسها</string>
    <!-- A new-video notification's title when the channel's name isn't known. -->
    <string name="app_new_video_unnamed">فيديو جديد</string>

    <!-- The signed-in account's name when Google's page didn't give one. -->
    <string name="app_account_fallback_name">حساب YouTube</string>
    <!-- Errors shown on the signed-in feeds. %1$s is an HTTP status code ("403"). -->
    <string name="app_error_session_rejected">رفض YouTube الجلسة (%1$s). جرّب تسجيل الدخول مرة أخرى.</string>
    <string name="app_error_youtube_returned">ردّ YouTube بالرمز %1$s</string>
</resources>
