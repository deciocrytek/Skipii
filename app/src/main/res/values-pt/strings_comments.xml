<resources>
    <!-- ── Comments ─────────────────────────────────────────────────────────── -->

    <!-- Title of the comments card under the video and of the comments panel. -->
    <string name="comments_title">Comentários</string>
    <string name="comments_turned_off">Os comentários estão desativados neste vídeo.</string>
    <!-- Comments card, signed in, when the video has no comments yet. -->
    <string name="comments_none_add_first">Nenhum comentário ainda. Seja o primeiro a comentar.</string>
    <string name="comments_none">Nenhum comentário ainda.</string>
    <!-- Accessibility label of the panel's close (X) button. -->
    <string name="comments_close">Fechar comentários</string>
    <!-- Shown at the bottom of the comments panel instead of the comment box when signed out. -->
    <string name="comments_sign_in_to_comment">Faça login para comentar.</string>
    <!-- Above the comment box while replying. %1$s = the name of the person replied to. -->
    <string name="comments_replying_to">Respondendo a %1$s</string>
    <!-- Accessibility label of the X that stops replying. -->
    <string name="comments_cancel_reply">Cancelar resposta</string>
    <!-- Placeholder in the comment box. -->
    <string name="comments_add_reply">Adicione uma resposta…</string>
    <string name="comments_add_comment">Adicione um comentário…</string>
    <!-- Accessibility label of the send button (posts the comment). -->
    <string name="comments_post">Publicar</string>
    <!-- Accessibility label of the pin icon on a pinned comment. -->
    <string name="comments_pinned">Fixado</string>
    <!-- Accessibility labels of a comment's thumbs-up button. -->
    <string name="comments_like">Gostei</string>
    <string name="comments_unlike">Remover gostei</string>
    <!-- Accessibility label of the heart the video's creator gave a comment. -->
    <string name="comments_hearted">Coração do criador</string>
    <!-- Small text button under a comment, keep short. -->
    <string name="comments_reply">Responder</string>
    <!-- Text button that folds a comment's replies away. -->
    <string name="comments_hide_replies">Ocultar respostas</string>
    <!-- Text button that opens a comment's replies. %1$s = how many. -->
    <plurals name="comments_replies">
        <item quantity="one">%1$s resposta</item>
        <item quantity="many">%1$s de respostas</item>
        <item quantity="other">%1$s respostas</item>
    </plurals>
    <!-- Author shown on a comment the person just posted, until the page reloads. -->
    <string name="comments_you">Você</string>
    <!-- Errors shown under the comment box. -->
    <string name="comments_error_like">Não foi possível curtir esse comentário.</string>
    <string name="comments_error_post">Não foi possível publicar seu comentário.</string>
    <string name="comments_error_cant_post">Os comentários estão desativados ou não podem ser publicados neste vídeo.</string>
    <string name="comments_error_reply_not_found">Não foi possível encontrar o comentário para responder. Tente de novo.</string>
    <string name="comments_error_like_not_found">Não foi possível encontrar o comentário para curtir. Tente de novo.</string>
    <string name="comments_error_not_accepted">O YouTube não aceitou o comentário.</string>

    <!-- ── Captions ─────────────────────────────────────────────────────────── -->

    <!-- Title of the captions sheet and of the captions card in settings. -->
    <string name="captions_title">Legendas</string>
    <!-- Title of the transcript panel and the button that opens it. -->
    <string name="captions_transcript">Transcrição</string>
    <!-- Shown over the video while a translation model downloads. %1$s = a language name ("Alemão"). -->
    <string name="captions_downloading_language">Baixando %1$s para tradução…</string>
    <!-- Shown over the video while captions are being translated. %1$s = a language name. -->
    <string name="captions_translating_into">Traduzindo para %1$s…</string>
    <!-- Error over the video / in the transcript. %1$s = a language name. -->
    <string name="captions_error_download">Não foi possível baixar %1$s para tradução.</string>
    <string name="captions_error_load">Não foi possível carregar estas legendas.</string>
    <!-- Note after a caption track's language in the list: captions YouTube made itself from speech. -->
    <string name="captions_auto_generated">geradas automaticamente</string>
    <!-- Short form of "auto-generated", in a small chip next to the transcript's title, keep short. -->
    <string name="captions_auto">auto</string>
    <!-- Notes after a translation language in the list. -->
    <string name="captions_note_downloading">baixando…</string>
    <!-- %1$s = the language translated from ("do inglês" / "from English"). -->
    <string name="captions_note_from">de %1$s</string>
    <!-- The translation model still has to be downloaded; "MB" = megabytes. -->
    <string name="captions_note_download_size">download de ~30 MB</string>
    <!-- Section heading in the captions list (shown in capitals): the languages that are translated by the phone itself. -->
    <string name="captions_translated_on_phone">TRADUZIDAS NO SEU TELEFONE</string>
    <!-- Row at the end of the captions list that shows every language. -->
    <string name="captions_more_languages">Mais idiomas</string>
    <string name="captions_none">Este vídeo não tem legendas.</string>
    <!-- Accessibility label of the check on the chosen row. -->
    <string name="captions_selected">Selecionado</string>
    <!-- Accessibility label of the transcript panel's close (X) button. -->
    <string name="captions_close_transcript">Fechar transcrição</string>
    <string name="captions_no_transcript">Este vídeo não tem legendas, então não há transcrição.</string>
    <string name="captions_no_lines">Nenhuma linha ainda.</string>
    <!-- Transcript search found nothing. %1$s = what was typed. -->
    <string name="captions_nothing_matches">Nada corresponde a “%1$s”.</string>
    <!-- Button that scrolls the transcript back to the line being said. -->
    <string name="captions_back_to_now">Voltar ao agora</string>
    <!-- Placeholder of the transcript's search field. -->
    <string name="captions_search_transcript">Pesquisar na transcrição</string>
    <!-- Accessibility label of the X that clears the search. -->
    <string name="captions_clear_search">Limpar pesquisa</string>

    <!-- Settings card (account sheet). -->
    <string name="captions_settings_subtitle">Escolha um idioma ou desative no player</string>
    <!-- A sample caption in the settings preview, shown as two lines over a picture: this is the first line… -->
    <string name="captions_sample_line_1">É assim que as legendas</string>
    <!-- …and this the second. Split the sentence about evenly. -->
    <string name="captions_sample_line_2">vão aparecer no vídeo.</string>
    <!-- Setting label, then its choice chips. -->
    <string name="captions_show">Mostrar legendas</string>
    <string name="captions_show_never">Nunca</string>
    <string name="captions_show_always">Sempre</string>
    <!-- Chip: show captions only when the video's language differs from the app's. %1$s = the app's language ("Português"). -->
    <string name="captions_show_foreign">Quando não estiver em %1$s</string>
    <!-- Setting label: the style captions are drawn in. -->
    <string name="captions_look">Estilo</string>
    <!-- Caption style chips: a plain black box, white text with a black outline, and Android's own caption settings. -->
    <string name="captions_look_classic">Clássico</string>
    <string name="captions_look_outline">Contorno</string>
    <string name="captions_look_system">Do Android</string>
    <!-- Setting label: caption text size, then its chips. -->
    <string name="captions_size">Tamanho</string>
    <string name="captions_size_small">Pequeno</string>
    <string name="captions_size_medium">Médio</string>
    <string name="captions_size_large">Grande</string>
    <string name="captions_size_huge">Enorme</string>
    <!-- Setting label over the downloaded translation languages (each with an X to delete it). -->
    <string name="captions_kept_languages">Idiomas de tradução neste telefone</string>
    <!-- Accessibility label of a downloaded language's X. %1$s = the language. -->
    <string name="captions_remove_language">Remover %1$s</string>
</resources>
