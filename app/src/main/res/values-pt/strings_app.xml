<resources>
    <!-- Bottom tab bar labels (MainActivity Tab, drawn by NavBar). Tight: the selected tab shows its label
         beside the icon in a shared pill; keep as short as possible (~12 characters). -->
    <string name="app_tab_home">Início</string>
    <string name="app_tab_subscriptions">Inscrições</string>
    <!-- YouTube's name for its short vertical videos; most languages keep "Shorts". -->
    <string name="app_tab_shorts">Shorts</string>
    <string name="app_tab_search">Pesquisar</string>
    <string name="app_tab_library">Biblioteca</string>

    <!-- Self-update: the Update pill in Home's header, beside the profile picture. Short (~10 characters). -->
    <string name="app_update_pill">Atualizar</string>
    <!-- Update pill while installing. Short (~10 characters). -->
    <string name="app_update_pill_installing">Instalando</string>
    <!-- Update pill after a failed download/install. Short (~10 characters). -->
    <string name="app_update_pill_retry">Repetir</string>
    <!-- Download progress, %1$s is a whole number 0-100 ("42%"). -->
    <string name="app_update_percent">%1$s%%</string>
    <!-- Title of the "What's new" sheet listing the release notes of a new version. -->
    <string name="app_update_whats_new">Novidades</string>
    <!-- Download size of the new version, %1$s is a number with one decimal ("16,8"). -->
    <string name="app_update_size_mb">%1$s MB</string>
    <string name="app_update_no_notes">Nenhuma nota foi publicada com esta versão.</string>
    <!-- The What's new sheet's full-width button. -->
    <string name="app_update_button">Atualizar</string>
    <!-- The sheet's button while downloading, %1$s is a whole number 0-100. -->
    <string name="app_update_downloading">Baixando %1$s%%</string>
    <string name="app_update_installing">Instalando…</string>
    <string name="app_update_try_again">Tentar de novo</string>
    <!-- Notification channel name (Android Settings › Notifications). -->
    <string name="app_update_channel">Atualizações do app</string>
    <!-- Notification after the app updated itself, %1$s is the version ("0.5.79"). -->
    <string name="app_updated_title">Skipii atualizado para %1$s</string>
    <string name="app_updated_text">Toque para abrir</string>

    <!-- The Subscribe button (player and channel page). Short: shares a row with the bell key. -->
    <string name="app_subscribe">Inscrever-se</string>
    <string name="app_subscribed">Inscrito</string>
    <!-- Accessibility labels of the bell key next to Subscribed. -->
    <string name="app_bell_on_description">Sino ativado: todos os vídeos novos. Toque para desativar</string>
    <string name="app_bell_off_description">Sino: receba uma notificação a cada vídeo novo</string>
    <!-- Messages after turning a channel's bell on/off. %1$s is the channel's name. -->
    <string name="app_bell_on_message">Todos os vídeos novos de %1$s</string>
    <string name="app_bell_off_message">Notificações desativadas para %1$s</string>
    <!-- Same, when the channel's name isn't known. -->
    <string name="app_bell_on_message_unnamed">Todos os vídeos novos deste canal</string>
    <string name="app_bell_off_message_unnamed">Notificações desativadas para este canal</string>
    <string name="app_bell_failed">Não foi possível alterar o sino.</string>
    <!-- Notifications were refused when asked (Android 13+). -->
    <string name="app_bell_allow_notifications">Permita as notificações do Skipii para usar o sino.</string>
    <!-- Notifications are off in Android's settings; the settings page opens next. -->
    <string name="app_bell_turn_on_notifications">Ative as notificações do Skipii para usar o sino.</string>

    <!-- Notification channel for new videos from channels with the bell on (Android Settings › Notifications). -->
    <string name="app_new_videos_channel">Vídeos novos</string>
    <string name="app_new_videos_channel_description">Todos os vídeos novos dos canais com o sino ativado</string>
    <!-- A new-video notification's title when the channel's name isn't known. -->
    <string name="app_new_video_unnamed">Vídeo novo</string>

    <!-- The signed-in account's name when Google's page didn't give one. -->
    <string name="app_account_fallback_name">Conta do YouTube</string>
    <!-- Errors shown on the signed-in feeds. %1$s is an HTTP status code ("403"). -->
    <string name="app_error_session_rejected">O YouTube recusou a sessão (%1$s). Tente fazer login de novo.</string>
    <string name="app_error_youtube_returned">O YouTube retornou %1$s</string>
    <!-- The live activity's notification channel, and its skip buttons. %1$s = seconds ("10"). -->
    <string name="app_live_channel">Tocando em segundo plano</string>
    <string name="app_live_channel_description">Controles de reprodução enquanto o Skipii não está na tela</string>
    <string name="app_live_back">−%1$s s</string>
    <string name="app_live_forward">+%1$s s</string>
</resources>
