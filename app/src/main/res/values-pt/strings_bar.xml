<resources>
    <!-- The open player's bar (the tab bar turns into it): play, -10 / +10, audio only, the ⋮ key. -->
    <!-- Accessibility labels of the bar's play button. -->
    <string name="bar_play">Reproduzir</string>
    <string name="bar_pause">Pausar</string>
    <!-- Accessibility labels of the bar's seek buttons. -->
    <!-- Accessibility label of the ⋮ key that opens the card of tools. -->
    <string name="bar_more_controls">Mais controles</string>
    <!-- Accessibility label of the ✕ the ⋮ key turns into. -->
    <string name="bar_close">Fechar</string>
    <!-- Accessibility labels of the audio only button (plays sound without the picture). -->
    <string name="bar_audio_only">Somente áudio</string>
    <string name="bar_audio_only_on">Somente áudio ativado</string>

    <!-- Tool labels under 58 dp round buttons in one row (up to six): very small text, keep VERY short (~9 characters). -->
    <string name="bar_tool_speed">Velocidade</string>
    <string name="bar_tool_quality">Qualidade</string>
    <!-- Picture-in-picture, abbreviated. -->
    <string name="bar_tool_pip">PiP</string>
    <string name="bar_tool_captions">Legendas</string>
    <string name="bar_tool_fullscreen">Tela cheia</string>
    <!-- Plays the next video. -->
    <string name="bar_tool_next">Próximo</string>

    <!-- Title of the chapter list, and the accessibility label of the button that opens it. -->
    <string name="bar_chapters">Capítulos</string>
    <!-- Above the chapter list: which chapter is playing, e.g. "3 de 12". -->
    <string name="bar_chapter_position">%1$s de %2$s</string>
    <!-- A chapter with no title: "Capítulo 3". -->
    <string name="bar_chapter_untitled">Capítulo %1$s</string>

    <!-- Quality list title. -->
    <string name="bar_quality">Qualidade</string>
    <!-- The quality that picks itself from the connection. Short, shown on a small round button too. -->
    <string name="bar_quality_auto">Auto</string>
    <!-- Next to the quality list's title: the quality playing now. %1$s = "720p". -->
    <string name="bar_quality_playing">Tocando %1$s</string>
    <!-- After "Auto" in the quality list: the height it plays right now. %1$s = 720 (shown as "720p agora"). -->
    <string name="bar_quality_now">%1$sp agora</string>
    <!-- Note after the lowest qualities (240p and below): uses little mobile data. -->
    <string name="bar_quality_data_saver">Economia de dados</string>
    <!-- Accessibility label of the check on the chosen row of a list. -->
    <string name="bar_selected">Selecionado</string>

    <!-- Captions list title (next to an on/off switch). -->
    <string name="bar_captions">Legendas</string>
    <!-- Section heading in the captions list, written in capitals: languages the phone translates the captions into. -->
    <string name="bar_captions_translated">TRADUZIDAS NO SEU TELEFONE</string>
    <!-- Captions list row that shows every language. -->
    <string name="bar_captions_more_languages">Mais idiomas</string>
    <!-- Captions list button that opens the full text of the video's captions. -->
    <string name="bar_transcript">Transcrição</string>

    <!-- Message when the phone's settings don't allow picture-in-picture for the app. -->
    <string name="bar_pip_off">O picture-in-picture está desativado para o Skipii nas Configurações.</string>

    <!-- Pill above the scrub preview: let go here to not jump. Short. -->
    <string name="bar_cancel">Cancelar</string>

    <!-- Speed panel. Under the big speed number: whether the speed applies to every video or only this one. -->
    <string name="bar_speed_every_video">Todos os vídeos</string>
    <string name="bar_speed_this_video">Só este vídeo</string>
    <!-- Checkbox: keep this speed for every video. -->
    <string name="bar_speed_remember">Lembrar para todos os vídeos</string>
    <!-- Under the checkbox: remembering ends when the speed is set back to normal (1×). -->
    <string name="bar_speed_remember_note">Até você voltar para 1×</string>
</resources>
