<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s mil</string>
    <string name="count_millions">%1$s mi</string>
    <string name="count_billions">%1$s bi</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1,2 mi"); the quantity is the exact count. -->
    <plurals name="views_count">
        <item quantity="one">%1$s visualização</item>
        <item quantity="many">%1$s de visualizações</item>
        <item quantity="other">%1$s visualizações</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="one">%1$s inscrito</item>
        <item quantity="many">%1$s de inscritos</item>
        <item quantity="other">%1$s inscritos</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("há 3 dias"). -->
    <string name="age_just_now">agora mesmo</string>
    <string name="age_streamed">Transmitido %1$s</string>
    <string name="age_premiered">Estreou %1$s</string>

    <!-- The account sheet's Language card (LanguageSettings). -->
    <string name="language_title">Idioma</string>
    <string name="language_phone">Idioma do telefone</string>
    <!-- %1$s is the language's own name ("Español"). -->
    <string name="language_phone_named">Idioma do telefone (%1$s)</string>
    <string name="language_line">Os textos do próprio app. Vídeos, títulos e comentários ficam como os criadores escreveram.</string>
</resources>
