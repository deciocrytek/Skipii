<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── Shared ─────────────────────────────────────────────────────────── -->
    <!-- Button after an error (a feed, a search, a channel, the playlists list). -->
    <string name="ui_try_again">Tentar de novo</string>
    <!-- Accessibility label of a round back-arrow button at the top of a page. -->
    <string name="ui_back">Voltar</string>
    <!-- Button that closes a page or message. -->
    <string name="ui_close">Fechar</string>
    <!-- Button, ~20 characters: opens Google's sign-in page. -->
    <string name="ui_sign_in_with_google">Fazer login com o Google</string>
    <!-- Name of the account's built-in playlist of videos saved for later (YouTube's "Watch later"). -->
    <string name="ui_watch_later">Assistir mais tarde</string>
    <!-- Name of the account's built-in playlist of liked videos. -->
    <string name="ui_liked_videos">Vídeos curtidos</string>

    <!-- ── Long-press options on a video ──────────────────────────────────── -->
    <string name="ui_play_next">Tocar a seguir</string>
    <string name="ui_add_to_queue">Adicionar à fila</string>
    <string name="ui_save_to_watch_later">Salvar em Assistir mais tarde</string>
    <!-- Option and the title of the sheet listing the account's playlists. -->
    <string name="ui_save_to_playlist">Salvar na playlist</string>
    <string name="ui_share">Compartilhar</string>

    <!-- ── Save to playlist sheet ─────────────────────────────────────────── -->
    <!-- Accessibility label of the check on a playlist that holds the video. -->
    <string name="ui_saved">Salvo</string>
    <!-- Playlist privacy, a small chip (~10 characters) and the line under a playlist's name. -->
    <string name="ui_privacy_private">Privada</string>
    <string name="ui_privacy_unlisted">Não listada</string>
    <string name="ui_privacy_public">Pública</string>
    <string name="ui_new_playlist">Nova playlist</string>
    <!-- Hint inside the empty name field of a new playlist. -->
    <string name="ui_playlist_name">Nome da playlist</string>
    <!-- Small button (~10 characters) that creates the new playlist. -->
    <string name="ui_create">Criar</string>

    <!-- ── Queue ──────────────────────────────────────────────────────────── -->
    <!-- Card under the player: "Fila · 3" = 3 videos queued (%1$s). Keep short. -->
    <plurals name="ui_queue_count">
        <item quantity="one">Fila · %1$s</item>
        <item quantity="many">Fila · %1$s</item>
        <item quantity="other">Fila · %1$s</item>
    </plurals>
    <!-- Small button (~8 characters) that empties the queue. -->
    <string name="ui_clear">Limpar</string>
    <!-- Title of the queue sheet. -->
    <string name="ui_queue">Fila</string>
    <!-- Accessibility label of the X on a queued video. -->
    <string name="ui_remove_from_queue">Remover da fila</string>
    <string name="ui_queue_empty">Nada na fila. Toque e mantenha pressionado um vídeo para adicioná-lo.</string>

    <!-- ── Account sheet: settings ────────────────────────────────────────── -->
    <!-- Line under the SponsorBlock switch. -->
    <string name="ui_sponsorblock_line">Pular patrocínios e outros segmentos</string>
    <!-- Required credit under the SponsorBlock settings; keep "sponsor.ajay.app" and "CC BY-NC-SA 4.0" as they are. -->
    <string name="ui_sponsorblock_credit">Segmentos do SponsorBlock (sponsor.ajay.app), um projeto da comunidade. Dados licenciados sob CC BY-NC-SA 4.0.</string>
    <string name="ui_player_controls">Controles do player</string>
    <!-- Line under "Player controls" when the controls live in the bottom pill. -->
    <string name="ui_player_controls_in_bar_line">Na barra de reprodução, na parte de baixo do player</string>
    <!-- Line under "Player controls" when the controls are drawn over the video. -->
    <string name="ui_player_controls_on_video_line">No vídeo; arraste o marcador na borda de baixo para avançar ou voltar</string>
    <!-- Chips (~14 characters): where the player's controls live. -->
    <string name="ui_player_controls_pill">Barra</string>
    <string name="ui_player_controls_on_video">No vídeo</string>
    <!-- Title of the Shorts setting (YouTube's short vertical videos; use YouTube's own name for them in your language). -->
    <string name="ui_shorts">Shorts</string>
    <string name="ui_shorts_on_line">Mostrar a guia Shorts</string>
    <string name="ui_shorts_off_line">A guia Shorts fica oculta e nenhum Short é carregado</string>
    <string name="ui_appearance">Aparência</string>
    <!-- Theme mode chips (~10 characters). "AMOLED" is the fourth and stays as it is. -->
    <string name="ui_mode_system">Sistema</string>
    <string name="ui_mode_light">Claro</string>
    <string name="ui_mode_dark">Escuro</string>
    <!-- Theme taken from the phone's wallpaper colours; label under a 56 dp swatch, keep short (~10 characters). -->
    <string name="ui_theme_wallpaper">Plano de fundo</string>
    <!-- Accessibility label of the check on the selected theme. -->
    <string name="ui_selected">Selecionado</string>

    <!-- ── Sign-in ────────────────────────────────────────────────────────── -->
    <!-- Accessibility label of the X that leaves the sign-in page. -->
    <string name="ui_cancel">Cancelar</string>
    <string name="ui_sign_in_title">Fazer login no YouTube</string>
    <!-- Under the title of the sign-in page; keep "accounts.google.com" as it is. -->
    <string name="ui_sign_in_line">accounts.google.com · guardado com criptografia neste telefone</string>
    <string name="ui_sign_in_error">Login feito, mas o YouTube não respondeu. Verifique sua conexão e tente de novo.</string>
    <string name="ui_finishing_sign_in">Concluindo o login…</string>
    <!-- Accessibility label of the account button when signed out. -->
    <string name="ui_sign_in">Fazer login</string>
    <string name="ui_account_pitch_title">Seu YouTube, sem anúncios</string>
    <string name="ui_account_pitch_body">Faça login para ver suas recomendações, inscrições, histórico e playlists. Curtidas, inscrições, Assistir mais tarde e o histórico de exibição são sincronizados com sua conta.</string>
    <string name="ui_sign_out">Sair</string>

    <!-- ── Home / Subscriptions / Library ─────────────────────────────────── -->
    <string name="ui_home_signed_out_title">Suas recomendações, sem os anúncios</string>
    <string name="ui_home_signed_out_body">Faça login com o Google para ver seu feed do YouTube ou simplesmente pesquise.</string>
    <!-- Text link under "Sign in with Google" on Home when signed out. -->
    <string name="ui_search_instead">Pesquisar</string>
    <!-- Page title (large header). -->
    <string name="ui_subscriptions_title">Inscrições</string>
    <string name="ui_subscriptions_signed_out_title">Suas inscrições</string>
    <string name="ui_subscriptions_signed_out_body">Faça login com o Google para ver vídeos novos dos canais em que você se inscreveu.</string>
    <!-- Page title (large header). -->
    <string name="ui_library_title">Biblioteca</string>
    <string name="ui_library_signed_out_title">Sua biblioteca</string>
    <string name="ui_library_signed_out_body">Faça login com o Google para ver seu histórico, Assistir mais tarde, vídeos curtidos e playlists.</string>
    <!-- Section title in Library: videos watched. -->
    <string name="ui_history">Histórico</string>
    <string name="ui_history_empty">Nada assistido ainda.</string>
    <!-- Section title in Library. -->
    <string name="ui_playlists">Playlists</string>
    <string name="ui_playlist_empty_title">Nada aqui ainda</string>
    <string name="ui_playlist_empty_body">Os vídeos que você adicionar a esta playlist vão aparecer aqui.</string>

    <!-- ── Search ─────────────────────────────────────────────────────────── -->
    <!-- Page title (large header). -->
    <string name="ui_search_title">Pesquisar</string>
    <!-- Hint inside the empty search field. -->
    <string name="ui_search_hint">Pesquisar no YouTube</string>
    <!-- Accessibility label of the X that empties the search field. -->
    <string name="ui_clear_search">Limpar</string>
    <string name="ui_search_error_title">A pesquisa não carregou</string>
    <string name="ui_search_intro_title">Pesquise sem anúncios</string>
    <string name="ui_search_intro_body">Os resultados tocam na hora, sem anúncios e sem login.</string>
    <string name="ui_search_nothing_found">Nada encontrado</string>
    <!-- %1$s = what was searched for. -->
    <string name="ui_search_no_match">Nenhum vídeo corresponde a “%1$s”.</string>
    <string name="ui_recent_searches">Pesquisas recentes</string>
    <!-- Text link beside "Recent searches". -->
    <string name="ui_clear_all">Limpar tudo</string>
    <!-- Accessibility label of the X on a past search. -->
    <string name="ui_remove_search">Remover</string>

    <!-- ── Channel page and feeds ─────────────────────────────────────────── -->
    <string name="ui_subscription_error">Não foi possível atualizar sua inscrição.</string>
    <string name="ui_channel_error_title">Não foi possível carregar este canal</string>
    <!-- Section title on a channel page: its uploads. -->
    <string name="ui_videos">Vídeos</string>
    <string name="ui_channel_sort_latest">Mais recentes</string>
    <string name="ui_channel_sort_popular">Populares</string>
    <string name="ui_channel_sort_oldest">Mais antigos</string>
    <string name="ui_see_all">Ver tudo</string>
    <string name="ui_channel_popular_videos">Vídeos populares</string>
    <string name="ui_channel_featured_channels">Canais em destaque</string>
    <string name="ui_channel_no_videos">Este canal ainda não postou vídeos.</string>
    <string name="ui_channel_no_shorts">Este canal ainda não postou Shorts.</string>
    <string name="ui_channel_no_playlists">Este canal não tem playlists públicas.</string>
    <string name="ui_feed_error_title">Não foi possível carregar</string>
    <!-- Shown when an account feed fails because the session ended. -->
    <string name="ui_signed_out_error">Você saiu da sua conta.</string>
    <string name="ui_chip_empty_title">Nada por aqui</string>
    <string name="ui_chip_empty_body">O YouTube não enviou vídeos para “%1$s”.</string>
    <string name="ui_not_interested">Não tenho interesse</string>
    <string name="ui_dont_recommend_channel">Não recomendar o canal</string>
    <plurals name="ui_seek_back">
        <item quantity="one">Voltar %1$s segundo</item>
        <item quantity="many">Voltar %1$s segundos</item>
        <item quantity="other">Voltar %1$s segundos</item>
    </plurals>
    <plurals name="ui_seek_forward">
        <item quantity="one">Avançar %1$s segundo</item>
        <item quantity="many">Avançar %1$s segundos</item>
        <item quantity="other">Avançar %1$s segundos</item>
    </plurals>
</resources>
