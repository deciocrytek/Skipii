    <string name="ui_subscription_error">आपकी सदस्यता अपडेट नहीं हो सकी.</string>
    <string name="ui_channel_error_title">यह चैनल लोड नहीं हो सका</string>
    <!-- Section title on a channel page: its uploads. -->
    <string name="ui_videos">वीडियो</string>
    <string name="ui_feed_error_title">इसे लोड नहीं किया जा सका</string>
    <!-- Shown when an account feed fails because the session ended. -->
    <string name="ui_signed_out_error">आप साइन आउट हो गए हैं.</string>
