    <string name="ui_search_no_match">“%1$s” से मेल खाता कोई वीडियो नहीं मिला.</string>
    <string name="ui_recent_searches">हाल ही की खोजें</string>
    <!-- Text link beside "Recent searches". -->
    <string name="ui_clear_all">सब साफ़ करें</string>
    <!-- Accessibility label of the X on a past search. -->
    <string name="ui_remove_search">हटाएं</string>

