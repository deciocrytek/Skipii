    <string name="ui_search_hint">YouTube पर खोजें</string>
    <!-- Accessibility label of the X that empties the search field. -->
    <string name="ui_clear_search">साफ़ करें</string>
    <string name="ui_search_error_title">खोज लोड नहीं हुई</string>
    <string name="ui_search_intro_title">बिना विज्ञापनों के खोजें</string>
    <string name="ui_search_intro_body">नतीजे तुरंत चलते हैं, बिना विज्ञापन और बिना साइन इन के.</string>
    <string name="ui_search_nothing_found">कुछ नहीं मिला</string>
