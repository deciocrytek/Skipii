<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s हज़ार</string>
    <string name="count_millions">%1$s मिलियन</string>
    <string name="count_billions">%1$s अरब</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1.2M"); the quantity is the exact count. -->
    <plurals name="views_count">
        <item quantity="one">%1$s व्यू</item>
        <item quantity="other">%1$s व्यू</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="one">%1$s सदस्य</item>
        <item quantity="other">%1$s सदस्य</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("3 days ago"). -->
    <string name="age_just_now">अभी-अभी</string>
    <string name="age_streamed">%1$s स्ट्रीम किया गया</string>
    <string name="age_premiered">%1$s प्रीमियर हुआ</string>

    <!-- The account sheet's Language card (LanguageSettings). -->
    <string name="language_title">भाषा</string>
    <string name="language_phone">फ़ोन की भाषा</string>
    <!-- %1$s is the language's own name ("Español"). -->
    <string name="language_phone_named">फ़ोन की भाषा (%1$s)</string>
    <string name="language_line">यह ऐप के अपने शब्दों की भाषा है. वीडियो, टाइटल और टिप्पणियां वैसी ही रहती हैं जैसी उनके क्रिएटर ने लिखी हैं.</string>
