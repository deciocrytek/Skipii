<resources>
    <!-- Compact counts (formatCount): %1$s is the number, already with the language's decimal mark ("1,2"). -->
    <string name="count_thousands">%1$s k</string>
    <string name="count_millions">%1$s M</string>
    <string name="count_billions">%1$s Md</string>
    <!-- Only used where count_in_ten_thousands is true (Japanese): 万 and 億. -->
    <string name="count_ten_thousands">%1$s万</string>
    <string name="count_hundred_millions">%1$s億</string>

    <!-- %1$s is a compact count from formatCount ("1.2M"); the quantity is the exact count. -->
    <plurals name="views_count">
        <item quantity="one">%1$s vue</item>
        <item quantity="many">%1$s de vues</item>
        <item quantity="other">%1$s vues</item>
    </plurals>
    <plurals name="subscribers_count">
        <item quantity="one">%1$s abonné</item>
        <item quantity="many">%1$s d\'abonnés</item>
        <item quantity="other">%1$s abonnés</item>
    </plurals>

    <!-- Ages (displayAge). %1$s is a relative time already in the app's language ("3 days ago"). -->
    <string name="age_just_now">à l\'instant</string>
    <string name="age_streamed">Diffusé %1$s</string>
    <string name="age_premiered">Première diffusion %1$s</string>

    <!-- The account sheet's Language card (LanguageSettings). -->
    <string name="language_title">Langue</string>
    <string name="language_phone">Langue du téléphone</string>
    <!-- %1$s is the language's own name ("Español"). -->
    <string name="language_phone_named">Langue du téléphone (%1$s)</string>
    <string name="language_line">Les textes de l\'application. Les vidéos, titres et commentaires restent tels que leurs créateurs les ont écrits.</string>
