<resources>
    <!-- The open player's bar (the tab bar turns into it): play, -10 / +10, audio only, the ⋮ key. -->
    <!-- Accessibility labels of the bar's play button. -->
    <string name="bar_play">Lecture</string>
    <string name="bar_pause">Pause</string>
    <!-- Accessibility labels of the bar's seek buttons. -->
    <string name="bar_back_10">Reculer de 10 secondes</string>
    <string name="bar_forward_10">Avancer de 10 secondes</string>
    <!-- Accessibility label of the ⋮ key that opens the card of tools. -->
    <string name="bar_more_controls">Plus de commandes</string>
    <!-- Accessibility label of the ✕ the ⋮ key turns into. -->
    <string name="bar_close">Fermer</string>
    <!-- Accessibility labels of the audio only button (plays sound without the picture). -->
    <string name="bar_audio_only">Audio seul</string>
    <string name="bar_audio_only_on">Audio seul activé</string>

    <!-- Tool labels under 58 dp round buttons in one row (up to six): very small text, keep VERY short (~9 characters). -->
    <string name="bar_tool_speed">Vitesse</string>
    <string name="bar_tool_quality">Qualité</string>
    <!-- Picture-in-picture, abbreviated. -->
    <string name="bar_tool_pip">PiP</string>
    <string name="bar_tool_captions">Sous-titres</string>
    <string name="bar_tool_fullscreen">Plein écran</string>
    <!-- Plays the next video. -->
    <string name="bar_tool_next">Suivant</string>

    <!-- Title of the chapter list, and the accessibility label of the button that opens it. -->
    <string name="bar_chapters">Chapitres</string>
    <!-- Above the chapter list: which chapter is playing, e.g. "3 of 12". -->
    <string name="bar_chapter_position">%1$s sur %2$s</string>
    <!-- A chapter with no title: "Chapter 3". -->
    <string name="bar_chapter_untitled">Chapitre %1$s</string>

    <!-- Quality list title. -->
    <string name="bar_quality">Qualité</string>
    <!-- The quality that picks itself from the connection. Short, shown on a small round button too. -->
    <string name="bar_quality_auto">Auto</string>
    <!-- Next to the quality list's title: the quality playing now. %1$s = "720p". -->
    <string name="bar_quality_playing">Lecture en %1$s</string>
    <!-- After "Auto" in the quality list: the height it plays right now. %1$s = 720 (shown as "720p now"). -->
    <string name="bar_quality_now">%1$sp actuellement</string>
    <!-- Note after the lowest qualities (240p and below): uses little mobile data. -->
    <string name="bar_quality_data_saver">Économie de données</string>
    <!-- Accessibility label of the check on the chosen row of a list. -->
    <string name="bar_selected">Sélectionné</string>

    <!-- Captions list title (next to an on/off switch). -->
    <string name="bar_captions">Sous-titres</string>
    <!-- Section heading in the captions list, written in capitals: languages the phone translates the captions into. -->
    <string name="bar_captions_translated">TRADUITS SUR VOTRE TÉLÉPHONE</string>
    <!-- Captions list row that shows every language. -->
    <string name="bar_captions_more_languages">Autres langues</string>
    <!-- Captions list button that opens the full text of the video's captions. -->
    <string name="bar_transcript">Transcription</string>

    <!-- Message when the phone's settings don't allow picture-in-picture for the app. -->
    <string name="bar_pip_off">Le mode Picture-in-picture est désactivé pour Skipii dans les paramètres.</string>

    <!-- Pill above the scrub preview: let go here to not jump. Short. -->
    <string name="bar_cancel">Annuler</string>

    <!-- Speed panel. Under the big speed number: whether the speed applies to every video or only this one. -->
    <string name="bar_speed_every_video">Toutes les vidéos</string>
    <string name="bar_speed_this_video">Cette vidéo uniquement</string>
    <!-- Checkbox: keep this speed for every video. -->
    <string name="bar_speed_remember">Mémoriser pour toutes les vidéos</string>
    <!-- Under the checkbox: remembering ends when the speed is set back to normal (1×). -->
    <string name="bar_speed_remember_note">Jusqu\'à ce que vous reveniez à 1×</string>
</resources>
