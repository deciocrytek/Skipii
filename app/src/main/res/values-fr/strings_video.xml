<resources>
    <!-- Video player overlay (portrait "on the video" controls and fullscreen), quality/speed pickers, errors. -->

    <!-- Small note under the loading spinner while YouTube runs a bot check on this connection. -->
    <string name="video_bot_check_waiting">YouTube vérifie cette connexion. Nouvelle tentative…</string>

    <!-- Accessibility labels of the round buttons on the video. -->
    <string name="video_audio_only">Audio seul</string>
    <!-- Accessibility label of the filled audio-only button shown while audio only is on (tap turns it off). -->
    <string name="video_audio_only_on">Audio seul activé</string>
    <string name="video_playback_speed">Vitesse de lecture</string>
    <string name="video_captions">Sous-titres</string>
    <string name="video_quality">Qualité</string>
    <string name="video_pip">Picture-in-picture</string>
    <string name="video_next">Suivant</string>
    <string name="video_fullscreen">Plein écran</string>
    <string name="video_exit_fullscreen">Quitter le plein écran</string>
    <string name="video_play">Lecture</string>
    <string name="video_pause">Pause</string>
    <!-- Accessibility label of the check mark on the chosen row of a picker. -->
    <string name="video_selected">Sélectionné</string>

    <!-- Message shown when picture-in-picture can't start because the user turned it off in Android's settings. -->
    <string name="video_pip_off">Le mode Picture-in-picture est désactivé pour Skipii dans les paramètres.</string>

    <!-- Quality: automatic. Also the start of the quality pill on the video ("Auto · 720p"): small pill, keep short. -->
    <string name="video_quality_auto">Auto</string>
    <!-- Subtitle of the Auto row in the quality sheet. -->
    <string name="video_quality_auto_best">Meilleure qualité jusqu\'à 1080p</string>
    <!-- Appended to the Auto row's subtitle after " · "; %1$s = a resolution like "720p". -->
    <string name="video_quality_auto_playing">lecture en %1$s</string>
    <!-- Under the quality sheet's title; %1$s = the format being played, like "1080p60 H.264". -->
    <string name="video_quality_playing">Lecture en %1$s</string>
    <!-- Quality tag for the lowest resolutions (240p and below). -->
    <string name="video_quality_data_saver">Économie de données</string>
    <!-- Quality tag for 1080p. -->
    <string name="video_quality_full_hd">Full HD</string>

    <!-- Title of the speed sheet. -->
    <string name="video_speed">Vitesse</string>

    <!-- Headers of the small fullscreen picker cards, shown in CAPITALS (write them in capitals where the script has them). -->
    <string name="video_drop_captions">SOUS-TITRES</string>
    <string name="video_drop_quality">QUALITÉ</string>
    <string name="video_drop_speed">VITESSE</string>

    <!-- Captions card: row that turns captions off. -->
    <string name="video_captions_off">Désactivés</string>
    <!-- Captions card: small grey tags after a language name. -->
    <string name="video_captions_tag_auto">auto</string>
    <string name="video_captions_tag_downloading">téléchargement</string>
    <string name="video_captions_tag_translated">traduits</string>
    <string name="video_captions_tag_download">à télécharger</string>

    <!-- Speed card: tag after 1× -->
    <string name="video_speed_normal">Normale</string>
    <!-- Speed card: tag after a speed set on the ruler that isn't one of the presets. -->
    <string name="video_speed_custom">Personnalisée</string>
    <!-- Speed card: row that keeps the speed for every video (toggle). -->
    <string name="video_speed_every_video">Toutes les vidéos</string>

    <!-- SponsorBlock pill, small: %1$s = the segment kind ("sponsor", "intro", …). Keep short. -->
    <string name="video_skip_segment">Passer : %1$s</string>
    <!-- After an automatic skip: %1$s = length ("1:12"), %2$s = the segment kind ("sponsor"). -->
    <string name="video_skipped_segment">Passé : %2$s (%1$s)</string>
    <!-- Button after the "Skipped …" note. -->
    <string name="video_undo">Annuler</string>

    <!-- Button on the playback error panel. -->
    <string name="video_try_again">Réessayer</string>
    <string name="video_open_in_youtube">Ouvrir dans YouTube</string>
</resources>
