<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The speed ruler's haptic ticks (SpeedHaptics). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Playback controls as a Live Update while the app is off screen (LiveActivity.kt, Android 16+). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Downloads (0.6.0): WorkManager's foreground job while videos download. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Self-update from the GitHub releases (AppUpdate); the second lets Android 12+ do it
         without a prompt once Skipii installed itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The same APK runs on Android TV / Google TV (Tv.kt): no touchscreen needed, and the TV's
         launcher lists it (LEANBACK_LAUNCHER) with its banner. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".SkipiiApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Skipii">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <!-- Not singleTask: a bubble needs its own task, and singleTask hands it the
                 app's one task instead (System UI kills it, or a later launch from Home
                 pulls it out of the bubble and leaves the bubble blank). MainActivity
                 keeps the app to one window itself. -->
            <!-- Orientation is set at runtime (OrientationController): portrait everywhere
                 except the open player. configChanges keeps the activity, the player
                 surface and all state alive across rotation, folding and unfolding (a
                 Galaxy Fold's two screens differ in density too) and a keyboard plugged
                 in. Never add locale: picking a language rebuilds the window. Android 16 ignores
                 orientation requests on large displays without this opt-out. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- YouTube links from other apps (GitHub #59; IncomingLinks, Description.kt). Not verifiable
                 (not our domain): Android 12+ opens them in Skipii once it's allowed under Settings › Apps ›
                 Skipii › Open by default (Settings › About › Open YouTube links leads there). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/channel/" />
                <data android:pathPrefix="/@" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
            <!-- A link shared to Skipii as text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LiveControlsReceiver"
            android:exported="false" />

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Home-screen widgets (0.6.0). -->
        <receiver android:name=".PlayerWidget" android:exported="false" android:label="@string/widget_player_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_player_info" />
        </receiver>
        <receiver android:name=".UpNextWidget" android:exported="false" android:label="@string/widget_upnext_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_upnext_info" />
        </receiver>
        <receiver android:name=".SearchWidget" android:exported="false" android:label="@string/widget_search_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_search_info" />
        </receiver>
        <receiver android:name=".WidgetControlsReceiver" android:exported="false" />
        <!-- Downloads run as a WorkManager foreground job (Android 14+ wants its type). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
